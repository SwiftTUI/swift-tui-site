---
import "../styles/site.css";
import "../styles/home.css";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import Quickstart from "../components/Quickstart.astro";
import HomeStory from "../components/HomeStory.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteIcons from "../components/SiteIcons.astro";
import ThemeScript from "../components/ThemeScript.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (import.meta.env.SITE ?? "https://swifttui.sh").replace(/\/$/, "");
const canonical = `${site}${base || ""}/`;
const title = "SwiftTUI · Build terminal interfaces in Swift";
const description =
  "SwiftTUI brings familiar views, state, focus, and layout to terminal interfaces, with browser and native hosts for the same authored scene.";
const ogImage = `${canonical}og.png`;

const softwareSourceCodeJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "SwiftTUI",
  description,
  programmingLanguage: "Swift",
  runtimePlatform:
    "Swift 6.3, macOS 15+, iOS 18+, Linux, WASI, Android arm64 host",
  codeRepository: "https://github.com/SwiftTUI/swift-tui",
  url: canonical,
  license: "https://github.com/SwiftTUI/swift-tui/blob/0.1.15/LICENSE",
  author: {
    "@type": "Organization",
    name: "GoodHats",
    url: "https://github.com/GoodHatsLLC",
  },
  keywords: [
    "Swift",
    "SwiftUI",
    "TUI",
    "Terminal UI",
    "WASI",
    "Android",
    "Cross platform",
    "Swift Package",
    "Swift 6",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Swift, SwiftUI, TUI, Terminal UI, WASI, Android, Swift 6, Swift package, terminal framework, declarative TUI, GoodHats"
    />
    <meta name="author" content="GoodHats" />
    <meta
      name="theme-color"
      content="#f5f7f3"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#101512"
      media="(prefers-color-scheme: dark)"
    />
    <ThemeScript />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content="SwiftTUI" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content="SwiftTUI: build terminal interfaces in Swift"
    />
    <meta property="og:site_name" content="SwiftTUI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="SwiftTUI" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <SiteIcons />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(softwareSourceCodeJsonLd)}
    />
  </head>
  <body class="home-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <Hero />
      <Quickstart />
      <HomeStory />
    </main>
    <SiteFooter />
  </body>
</html>
