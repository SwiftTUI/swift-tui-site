---
import Site from "../layouts/Site.astro";
import Hero from "../components/Hero.astro";
import GetStarted from "../components/GetStarted.astro";
import WhySwiftTUI from "../components/WhySwiftTUI.astro";
import Capabilities from "../components/Capabilities.astro";
import Proof from "../components/Proof.astro";
import Next from "../components/Next.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (import.meta.env.SITE ?? "https://swifttui.sh").replace(/\/$/, "");
const canonical = `${site}${base}/`;
const title = "SwiftTUI · Build terminal interfaces in Swift";
// This string is what search results and link unfurls show (it is reused as
// og:description, twitter:description and the JSON-LD description), so it
// carries the core pitch only: terminal UIs, SwiftUI semantics, one binary,
// try the demo. Host caveats live on the host repos, not here.
const description =
  "Build terminal user interfaces in Swift with views, state, focus, drawing, and animation. Compile native apps for macOS, Linux, and Windows, and share the same views with browser and native hosts. Try the live demo.";
const keywords =
  "Swift, SwiftUI, TUI, Terminal UI, terminal framework, declarative TUI, Swift 6, Swift package, macOS, Linux, Windows, WASI, OPTIONAL.DEV";

const softwareSourceCodeJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "SwiftTUI",
  description,
  programmingLanguage: "Swift",
  runtimePlatform:
    "Swift 6.4, macOS 15+, Linux, Windows 10 1809+ / Server 2019+; also WASI (browser), iOS 18+ (SwiftUI host), Android arm64 preview",
  codeRepository: "https://github.com/SwiftTUI/swift-tui",
  url: canonical,
  license: "https://github.com/SwiftTUI/swift-tui/blob/0.14.0/LICENSE",
  author: {
    "@type": "Organization",
    name: "OPTIONAL.DEV",
    url: "https://optional.dev",
  },
  keywords: [
    "Swift",
    "SwiftUI",
    "TUI",
    "Terminal UI",
    "Terminal framework",
    "Declarative TUI",
    "Swift Package",
    "Swift 6",
    "macOS",
    "Linux",
    "Windows",
    "WASI",
  ],
};
---

<Site title={title} description={description} path="/" keywords={keywords} bodyClass="home-page">
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(softwareSourceCodeJsonLd)}
  />
  <Hero />
  <GetStarted />
  <WhySwiftTUI />
  <Capabilities />
  <Proof />
  <Next />
</Site>
