---
import "../styles/site.css";
import "../styles/marketing.css";
import "../styles/home.css";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import GetStarted from "../components/GetStarted.astro";
import WhySwiftTUI from "../components/WhySwiftTUI.astro";
import Proof from "../components/Proof.astro";
import Next from "../components/Next.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteIcons from "../components/SiteIcons.astro";
import ThemeScript from "../components/ThemeScript.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (import.meta.env.SITE ?? "https://swifttui.sh").replace(/\/$/, "");
const canonical = `${site}${base || ""}/`;
const title = "SwiftTUI · Build terminal interfaces in Swift";
// This string is what search results and link unfurls show (it is reused as
// og:description, twitter:description, and the JSON-LD description), so it
// carries the core pitch only: terminal UIs, SwiftUI semantics, one binary,
// try the demo. Host caveats live on the host repos, not here.
const description =
  "Build terminal user interfaces in Swift with SwiftUI semantics: views, state, focus, gestures, and animation, compiled to one native binary for macOS, Linux, and Windows. Try the live demo, then run the same app in your own terminal.";
const ogImage = `${canonical}og.png`;

const softwareSourceCodeJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "SwiftTUI",
  description,
  programmingLanguage: "Swift",
  runtimePlatform:
    "Swift 6.3, macOS 15+, Linux, Windows 10 1809+ / Server 2019+; also WASI (browser), iOS 18+ (SwiftUI host), Android arm64 preview",
  codeRepository: "https://github.com/SwiftTUI/swift-tui",
  url: canonical,
  license: "https://github.com/SwiftTUI/swift-tui/blob/0.9.10/LICENSE",
  author: {
    "@type": "Organization",
    name: "OPTIONAL.DEV",
    url: "https://optional.dev",
  },
  keywords: [
    "Swift",
    "SwiftUI",
    "TUI",
    "Terminal UI",
    "Terminal framework",
    "Declarative TUI",
    "Swift Package",
    "Swift 6",
    "macOS",
    "Linux",
    "Windows",
    "WASI",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Swift, SwiftUI, TUI, Terminal UI, terminal framework, declarative TUI, Swift 6, Swift package, macOS, Linux, Windows, WASI, OPTIONAL.DEV"
    />
    <meta name="author" content="OPTIONAL.DEV" />
    <meta
      name="theme-color"
      content="#f5f7f3"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#101512"
      media="(prefers-color-scheme: dark)"
    />
    <ThemeScript />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content="SwiftTUI" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content="SwiftTUI: build terminal interfaces in Swift"
    />
    <meta property="og:site_name" content="SwiftTUI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="SwiftTUI" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <SiteIcons />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(softwareSourceCodeJsonLd)}
    />
  </head>
  <body class="home-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <Hero />
      <GetStarted />
      <WhySwiftTUI />
      <Proof />
      <Next />
    </main>
    <SiteFooter />
  </body>
</html>
