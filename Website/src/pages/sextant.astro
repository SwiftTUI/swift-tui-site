---
import "../styles/site.css";
import "../styles/marketing.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteIcons from "../components/SiteIcons.astro";
import ThemeScript from "../components/ThemeScript.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (import.meta.env.SITE ?? "https://swifttui.sh").replace(/\/$/, "");
const canonical = `${site}${base || ""}/sextant/`;
const screenshot = `${site}${base || ""}/showcase/sextant.png`;
const title = "Sextant · A preview-first terminal inspector";
const description =
  "Navigate directories, inspect files, and hand off to the tools you already use. Sextant is a read-only terminal inspector built with SwiftTUI.";
const repo = "https://github.com/SwiftTUI/sextant";

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Sextant",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 15+",
  url: canonical,
  codeRepository: repo,
  license: `${repo}/blob/main/LICENSE`,
  programmingLanguage: "Swift",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={screenshot} />
    <meta
      property="og:image:alt"
      content="Sextant inspecting its own README in a split terminal browser"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={screenshot} />
    <meta
      name="theme-color"
      content="#f5f7f3"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#101512"
      media="(prefers-color-scheme: dark)"
    />
    <ThemeScript />
    <SiteIcons />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(softwareJsonLd)}
    />
  </head>
  <body class="marketing-subpage sextant-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />

    <main id="main">
      <section class="sextant-hero">
        <div class="shell">
          <div class="instrument-id mono" aria-label="Sextant product details">
            <span>Sextant</span>
            <span>Local file inspection</span>
            <span>macOS 15+</span>
          </div>

          <div class="hero-copy">
            <p class="eyebrow mono">A navigation instrument for the terminal</p>
            <h1>Find your bearing.<br />Inspect the file.</h1>
            <p class="lede">
              Sextant keeps directories, the current selection, and a useful
              preview in one keyboard-driven view. It reads; it never rearranges
              your filesystem.
            </p>
            <div class="hero-actions mono">
              <a class="primary" href={repo} rel="noreferrer noopener">
                View on GitHub <span aria-hidden="true">↗</span>
              </a>
              <a
                class="secondary"
                href={`${repo}/tree/main/docs`}
                rel="noreferrer noopener"
              >
                Product docs <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <div class="bearing" aria-label="Sextant workflow">
            <div class="bearing-rule" aria-hidden="true"></div>
            <ol>
              <li>
                <span class="bearing-mark mono">000°</span>
                <strong>Locate</strong>
                <span>Move through responsive directory columns.</span>
              </li>
              <li>
                <span class="bearing-mark mono">090°</span>
                <strong>Inspect</strong>
                <span>Preview text, binary data, metadata, and directories.</span>
              </li>
              <li>
                <span class="bearing-mark mono">180°</span>
                <strong>Hand off</strong>
                <span>Open, edit, reveal, or copy when you have the right file.</span>
              </li>
            </ol>
          </div>

          <figure class="journey">
            <div class="journey-bar mono">
              <span class="journey-label">Recorded terminal journey</span>
              <span class="journey-state">
                <span class="signal" aria-hidden="true"></span>
                real input · async render
              </span>
            </div>
            <picture>
              <source
                media="(prefers-reduced-motion: reduce)"
                srcset={`${base}/showcase/sextant.png`}
              />
              <img
                src={`${base}/showcase/sextant-journey.gif`}
                alt="Sextant navigating a directory, focusing a preview, opening help, and using its command palette"
                width="1400"
                height="560"
              />
            </picture>
            <figcaption>
              The checked-in journey runs the production asynchronous renderer
              inside a real pseudo-terminal. Reduced-motion settings show the
              accepted still frame instead.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="working-set" aria-labelledby="working-set-title">
        <div class="shell working-grid">
          <div class="section-heading">
            <p class="eyebrow mono">Useful before configuration</p>
            <h2 id="working-set-title">A complete built-in working set.</h2>
          </div>
          <div class="capabilities">
            <article>
              <span class="cap-key mono">TXT</span>
              <h3>Text, bounded</h3>
              <p>
                Strict UTF-8 plus BOM-aware UTF-8 and UTF-16 previews, with
                explicit truncation instead of an unbounded read.
              </p>
            </article>
            <article>
              <span class="cap-key mono">HEX</span>
              <h3>Binary, legible</h3>
              <p>
                A compact hexadecimal fallback keeps unknown files inspectable
                without trusting a device or special file.
              </p>
            </article>
            <article>
              <span class="cap-key mono">DIR</span>
              <h3>Context, retained</h3>
              <p>
                Metadata and directory summaries stay beside the browser trail,
                so a preview never costs your place.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="handoff" aria-labelledby="handoff-title">
        <div class="shell handoff-grid">
          <div>
            <p class="eyebrow mono">Read-only by design</p>
            <h2 id="handoff-title">Inspect here. Work elsewhere.</h2>
          </div>
          <div class="handoff-copy">
            <p>
              Sextant does not create, rename, move, or delete files. Optional
              tools such as <span class="mono">glow</span>,{" "}
              <span class="mono">jq</span>, and{" "}
              <span class="mono">chafa</span> can enrich a preview; failures
              fall back to the built-in view.
            </p>
            <p>
              When inspection becomes action, open the file, send it to your
              editor, reveal it in Finder, or copy its path. Arguments remain
              arguments—Sextant does not interpolate paths into shell source.
            </p>
          </div>
          <div class="source-card">
            <div class="source-card-head mono">
              <span>Build from source</span>
              <span>Swift 6.3</span>
            </div>
            <pre><code>git clone https://github.com/SwiftTUI/sextant.git
cd sextant
swiftly run swift run sextant .</code></pre>
            <a href={`${repo}#readme`} rel="noreferrer noopener">
              Read install, controls, and configuration{" "}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .sextant-page {
    --sextant-terminal: #101312;
    --sextant-terminal-line: #343b36;
    --sextant-terminal-ink: #f1f4f2;
    --sextant-terminal-muted: #aeb8b1;
  }

  .sextant-hero {
    padding: 34px 0 70px;
  }

  .instrument-id {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 24px;
    padding: 10px 0;
    border-top: 1px solid var(--home-ink);
    border-bottom: 1px solid var(--home-ink);
    color: var(--home-quiet);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .instrument-id span:first-child {
    color: var(--home-ink);
    font-weight: 700;
  }

  .hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(280px, 0.82fr);
    column-gap: clamp(36px, 7vw, 104px);
    row-gap: 22px;
    align-items: end;
    padding: clamp(54px, 8vw, 106px) 0 46px;
  }

  .eyebrow {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--home-accent-ink);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--home-ink);
    font-size: clamp(48px, 7.4vw, 96px);
    font-weight: 520;
    line-height: 0.9;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .hero-copy .lede {
    max-width: 52ch;
    margin: 0;
    color: var(--home-muted);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    grid-column: 2;
    gap: 8px;
    flex-wrap: wrap;
    align-self: start;
  }

  .hero-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 42px;
    padding: 9px 13px;
    border: 1px solid var(--home-ink);
    border-radius: 3px;
    font-size: 12px;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .hero-actions .primary {
    background: var(--home-ink);
    color: var(--home-paper);
  }

  .hero-actions .primary:hover {
    border-color: var(--home-accent);
    background: var(--home-accent);
    color: var(--home-accent-on);
  }

  .hero-actions .secondary {
    color: var(--home-muted);
  }

  .hero-actions .secondary:hover {
    border-color: var(--home-accent);
    color: var(--home-ink);
  }

  .bearing {
    position: relative;
    padding: 0 0 26px;
  }

  .bearing-rule {
    position: absolute;
    top: 7px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--home-ink);
  }

  .bearing ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bearing li {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 12px;
    row-gap: 7px;
    padding-right: clamp(18px, 5vw, 72px);
  }

  .bearing li::before {
    content: "";
    grid-column: 1 / -1;
    width: 1px;
    height: 15px;
    margin-left: 11px;
    background: var(--home-ink);
  }

  .bearing-mark {
    color: var(--home-accent-ink);
    font-size: 10px;
  }

  .bearing strong {
    color: var(--home-ink);
    font-size: 13px;
  }

  .bearing li > span:last-child {
    grid-column: 2;
    color: var(--home-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .journey {
    margin: 0;
    border: 1px solid var(--home-ink);
    background: var(--sextant-terminal);
  }

  .journey-bar {
    display: flex;
    min-height: 42px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 8px 13px;
    border-bottom: 1px solid var(--sextant-terminal-line);
    color: var(--sextant-terminal-muted);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .journey-label {
    color: var(--sextant-terminal-ink);
  }

  .journey-state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .signal {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--home-terminal-accent);
    box-shadow: 0 0 0 3px rgb(98 214 191 / 14%);
  }

  .journey picture,
  .journey img {
    display: block;
    width: 100%;
  }

  .journey img {
    height: auto;
    background: var(--sextant-terminal);
  }

  .journey figcaption {
    padding: 11px 13px;
    border-top: 1px solid var(--sextant-terminal-line);
    color: var(--sextant-terminal-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
  }

  .working-set {
    padding: 72px 0;
    border-top: 1px solid var(--home-ink);
    border-bottom: 1px solid var(--home-ink);
    background: var(--home-paper-soft);
  }

  .working-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(40px, 8vw, 120px);
  }

  .section-heading h2,
  .handoff h2 {
    max-width: 13ch;
    margin: 14px 0 0;
    color: var(--home-ink);
    font-size: clamp(34px, 4.5vw, 58px);
    font-weight: 520;
    line-height: 0.96;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .capabilities {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--home-ink);
    border-left: 1px solid var(--home-ink);
  }

  .capabilities article {
    min-height: 240px;
    padding: 18px;
    border-right: 1px solid var(--home-ink);
    border-bottom: 1px solid var(--home-ink);
    background: var(--home-paper);
  }

  .cap-key {
    display: inline-block;
    min-width: 40px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--home-accent);
    color: var(--home-accent-ink);
    font-size: 10px;
  }

  .capabilities h3 {
    margin: 62px 0 0;
    color: var(--home-ink);
    font-size: 16px;
    letter-spacing: -0.025em;
  }

  .capabilities p {
    margin: 8px 0 0;
    color: var(--home-muted);
    font-size: 12.5px;
    line-height: 1.58;
  }

  .handoff {
    padding: 88px 0 104px;
  }

  .handoff-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.72fr) minmax(260px, 0.58fr) minmax(320px, 0.7fr);
    gap: clamp(32px, 5vw, 74px);
    align-items: start;
  }

  .handoff-copy {
    color: var(--home-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .handoff-copy p {
    margin: 0;
  }

  .handoff-copy p + p {
    margin-top: 18px;
  }

  .handoff-copy .mono {
    color: var(--home-ink);
    font-size: 0.92em;
  }

  .source-card {
    border: 1px solid var(--home-ink);
  }

  .source-card-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--home-ink);
    color: var(--home-muted);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .source-card pre {
    margin: 0;
    padding: 18px 16px;
    overflow-x: auto;
    border-bottom: 1px solid var(--home-ink);
    background: var(--sextant-terminal);
    color: var(--sextant-terminal-ink);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.75;
  }

  .source-card a {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 13px 15px;
    color: var(--home-accent-ink);
    font-family: var(--font-mono);
    font-size: 11px;
    transition: background 150ms ease, color 150ms ease;
  }

  .source-card a:hover {
    background: var(--home-paper-soft);
    color: var(--home-ink);
  }

  @media (max-width: 980px) {
    .working-grid,
    .handoff-grid {
      grid-template-columns: 1fr;
    }

    .section-heading h2,
    .handoff h2 {
      max-width: 18ch;
    }

    .handoff-copy {
      max-width: 64ch;
    }

    .source-card {
      width: min(100%, 620px);
    }
  }

  @media (max-width: 760px) {
    .hero-copy {
      grid-template-columns: 1fr;
      padding-top: 48px;
    }

    .hero-copy h1 {
      max-width: 12ch;
    }

    .hero-actions {
      grid-column: 1;
    }

    .bearing ol {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .bearing-rule {
      top: 0;
      bottom: 26px;
      left: 0;
      width: 1px;
      height: auto;
    }

    .bearing li {
      grid-template-columns: 54px minmax(0, 1fr);
      padding-right: 0;
      padding-left: 26px;
    }

    .bearing li::before {
      position: absolute;
      top: 0;
      left: 0;
      width: 15px;
      height: 1px;
      margin: 7px 0 0;
    }

    .bearing li > span:last-child {
      grid-column: 2;
    }

    .capabilities {
      grid-template-columns: 1fr;
    }

    .capabilities article {
      min-height: 0;
    }

    .capabilities h3 {
      margin-top: 32px;
    }
  }

  @media (max-width: 520px) {
    .sextant-hero {
      padding-top: 22px;
    }

    .instrument-id {
      grid-template-columns: 1fr auto;
    }

    .instrument-id span:nth-child(2) {
      display: none;
    }

    .hero-actions,
    .hero-actions a {
      width: 100%;
    }

    .journey-state {
      display: none;
    }

    .journey figcaption {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-actions a,
    .source-card a {
      transition: none;
    }
  }
</style>
