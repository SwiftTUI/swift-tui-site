---
import Site from "../layouts/Site.astro";
import Button from "../components/Button.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "SwiftTUI Showcase";
const description =
  "Real terminal apps built with SwiftTUI, every one a maintained example in swift-tui-examples you can clone and run, plus the same component gallery rendered by every host.";

// Live WebExample embed. The whole origin is cross-origin isolated (public/_headers
// applies COOP/COEP to /*), so the iframe's SharedArrayBuffer-backed stdin works on
// this page exactly as it does on the homepage demo. In `astro dev` without a composed
// wasm artifact the route 404s, so fall back to the poster — mirrors DemoTerminal.
const isDev = import.meta.env.DEV;
const webExampleDir =
  process.env.WEBEXAMPLE_DIR ?? "../.build/public-inputs/swift-tui-counter-demo/WebExample";
const hasLocalWebExampleArtifact =
  existsSync(resolve(process.cwd(), webExampleDir, "pages-dist/index.html")) &&
  existsSync(
    resolve(process.cwd(), webExampleDir, "pages-dist/TerminalApp/dist/assets/app.wasm"),
  );
const showWebStub = isDev && !hasLocalWebExampleArtifact;
const webIframeSrc = `${base}/webexample/?embed=marketing`;
const webDemoHref = `${base}/webexample/`;
const webSourceHref =
  "https://github.com/SwiftTUI/swift-tui-counter-demo/tree/main/WebExample";

type Host = {
  slug: string;
  platform: string;
  host: string;
  body: string;
  href: string;
  img: string;
  preview?: boolean;
};

// The same gallery surface (GalleryDemoViews / gallery-demo), rendered by each
// host. Terminal first: it is the native substrate and the core experience;
// the others are where the same view can travel. Host caveats (Android's
// packaging, IME, and semantics limits) live on the host repos' READMEs and
// in the Hosts-And-Platforms article, not in these captions.
const hosts: Host[] = [
  {
    slug: "terminal",
    platform: "Terminal",
    host: "SwiftTUICLI",
    body: "The native substrate. ANSI / Kitty / Sixel are negotiated against the live terminal, with mouse and signals on by default.",
    href: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/gallery",
    img: `${base}/showcase/host-terminal.png`,
  },
  {
    slug: "macos",
    platform: "macOS",
    host: "SwiftUIHost",
    body: "Retained inside a native SwiftUI window. Theme tokens swap at runtime; the authored views never branch on the host.",
    href: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/SwiftUIExample",
    img: `${base}/showcase/host-macos.png`,
  },
  {
    slug: "ios",
    platform: "iOS",
    host: "SwiftUIHost",
    body: "The same scenes in a native iOS app shell, with touch panning, keyboard entry for focused text inputs, and a VoiceOver-readable semantic overlay.",
    href: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/SwiftUIExample",
    img: `${base}/showcase/host-ios.png`,
  },
  {
    slug: "android",
    platform: "Android · arm64 preview",
    host: "SwiftTUIAndroidHost",
    body: "Swift paints through Compose and JNI. An arm64 preview; its current limits are recorded on swift-tui-android.",
    href: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/AndroidGallery",
    img: `${base}/showcase/host-android.png`,
    preview: true,
  },
];

type Tile = {
  slug: string;
  title: string;
  subtitle: string;
  body: string;
  repo: string;
  img: string;
};

// Same order as the swift-tui README's 2×2 (gifeditor · csvui · terminal-
// workspace · mrkdwn), then the two that only fit here.
const tiles: Tile[] = [
  {
    slug: "gifeditor",
    title: "GIF Editor",
    subtitle: "Canvas, layers, timeline, and undo/redo in the terminal.",
    body:
      "A GIF editor written as ordinary SwiftTUI views. Paint on a canvas, edit layers, scrub a timeline, and export animated GIFs with finite or continuous playback. Preview and export honor the authored total play count.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/gifeditor",
    img: `${base}/showcase/gifeditor.png`,
  },
  {
    slug: "csvui",
    title: "csvui",
    subtitle: "A viewer-first CSV/TSV workbench.",
    body:
      "It indexes the source bytes once and decodes only the rows the viewport needs, so a 34,000-row GeoNames city table stays responsive. Sparse editing, search, filtering, sorting, file watching, and safe atomic saves.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/csvui",
    img: `${base}/showcase/csvui.png`,
  },
  {
    slug: "terminal-workspace",
    title: "Terminal Workspace",
    subtitle: "Zellij-style tabs, splits, and a command palette.",
    body:
      "Multi-pane terminal workspace built on SwiftTUITerminalView. Persisted layouts, focused chrome, a command palette, and embedded PTY sessions from the separate terminal-view package.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/terminal-workspace",
    img: `${base}/showcase/terminal-workspace.png`,
  },
  {
    slug: "mrkdwn",
    title: "mrkdwn",
    subtitle: "Markdown as a responsive terminal document.",
    body:
      "A terminal Markdown reader built on swift-markdown: navigation, bounded search, theming, live reload on file changes, and inline images, shown here reading the SwiftTUI README.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/mrkdwn",
    img: `${base}/showcase/mrkdwn.png`,
  },
  {
    slug: "git-viz",
    title: "git-viz",
    subtitle: "Every SwiftTUICharts primitive against a real repo.",
    body:
      "Seventeen subcommands render BarChart, ColumnChart, StackedBarChart, ComparisonChart, LineChart, Sparkline, Timeline, HeatStrip, CalendarHeatmap, BulletChart, ThresholdGauge, Meter, and Legend against the git history of whatever repo you point it at. Dashboards in a terminal.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/git-viz",
    img: `${base}/showcase/git-viz.png`,
  },
  {
    slug: "sextant",
    title: "Sextant",
    subtitle: "Miller-column file browsing with inline previews.",
    body:
      "Navigate directory columns with bounded text, binary, metadata, and directory previews, then open or edit the file when you have your bearing, here pointed at the swift-tui-examples checkout.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/sextant",
    img: `${base}/showcase/sextant-browse.png`,
  },
];
---
<Site
  title={title}
  description={description}
  path="/showcase/"
  ogType="article"
  ogImageAlt="SwiftTUI showcase"
  twitterCard="summary"
  bodyClass="showcase-page"
>
  <Section id="showcase-top" aria-labelledby="showcase-title">
    <SectionHead id="showcase-title" level={1} eyebrow="Showcase">
      <Fragment slot="title">Built with SwiftTUI.</Fragment>
      Real, non-trivial terminal apps, every one a maintained example in{" "}
      <code>swift-tui-examples</code> you can clone and run with a single
      command. Then the encore: one component gallery, rendered by every host
      the same views can travel to.
    </SectionHead>
  </Section>

  <Section id="examples" aria-labelledby="examples-title">
    <SectionHead id="examples-title" eyebrow="Example apps">
      <Fragment slot="title">Built in the open.</Fragment>
      Maintained example apps from <code>swift-tui-examples</code>. Each builds
      from a fresh clone with one command.
    </SectionHead>
    <div class="card-grid card-grid--two">
      {
        tiles.map((tile) => (
          <FeatureCard
            title={tile.title}
            href={tile.repo}
            external
            cta="View source"
            media={{ src: tile.img, alt: `${tile.title} screenshot`, width: 1200, height: 750 }}
          >
            <span class="tile-sub">{tile.subtitle}</span>
            {tile.body}
          </FeatureCard>
        ))
      }
    </div>
  </Section>

  <Section id="hosts" aria-labelledby="hosts-title">
    <SectionHead id="hosts-title" eyebrow="Beyond the terminal">
      <Fragment slot="title">One gallery. Every host.</Fragment>
      The same <code>gallery-demo</code> view, drawn by the terminal and by
      each host it can travel to. Terminal first, not terminal only.
    </SectionHead>
    <div class="card-grid devices">
      {
        hosts.map((host) => (
          <FeatureCard
            title={host.platform}
            href={host.href}
            external
            cta="View example"
            class="device"
            media={{ src: host.img, alt: `SwiftTUI gallery running on ${host.platform}`, width: 1000, height: 1000 }}
          >
            <span class="host-badge mono">{host.host}</span>
            {host.body}
          </FeatureCard>
        ))
      }
    </div>

    <div class="web-feature media-frame">
      <div class="web-bar">
        <span class="web-bar__id">
          <span class="platform">Browser</span>
          <span class="host-badge mono">SwiftTUIWASI · @swifttui/web</span>
        </span>
        <span class="web-bar__url mono">swifttui.sh/webexample</span>
        <span class="web-bar__live mono"><span class="live-dot" aria-hidden="true"></span>live</span>
      </div>
      <div class="web-surface">
        {
          showWebStub ? (
            <div class="web-stub">
              <img class="web-poster" src={`${base}/showcase/host-web.png`} alt="" aria-hidden="true" />
              <p class="web-stub-note">
                The live wasm demo composes in production. Run
                <code>bun run build:wasm:dev</code> in <code>Website/</code> to mount it locally.
              </p>
            </div>
          ) : (
            <div class="web-stage">
              <iframe
                src={webIframeSrc}
                title="SwiftTUI counter running as a WASI browser app"
                loading="lazy"
                referrerpolicy="same-origin"
              />
              <img
                class="web-poster"
                src={`${base}/showcase/host-web.png`}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        }
      </div>
      <div class="web-meta">
        <p class="caption">
          The counter from the home page, built to <code>wasm32-wasi</code> and
          mounted through <code>@swifttui/web</code>: a canvas plus a real
          accessibility tree, no terminal emulator.
        </p>
        <div class="button-row web-actions">
          <Button href={webDemoHref} variant="primary" size="sm" trailingIcon="chevronRight">
            Open full demo
          </Button>
          <Button href={webSourceHref} variant="secondary" size="sm" icon="github" external>
            View source
          </Button>
        </div>
      </div>
    </div>
  </Section>

  <script>
    // Fade each web poster out once its iframe paints, so the live demo
    // hands off cleanly from the static screenshot.
    document.querySelectorAll(".web-stage iframe").forEach((frame) => {
      frame.addEventListener("load", () => frame.setAttribute("data-loaded", "true"));
    });
  </script>
</Site>

<style>
  .tile-sub {
    display: block;
    margin-bottom: var(--space-1);
    color: var(--text-strong);
  }

  .devices {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .devices :global(.swifttui-card__media) {
    aspect-ratio: 1 / 1;
  }

  .host-badge {
    display: block;
    margin-bottom: var(--space-1);
    color: var(--text-muted);
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  /* ── the browser host, running live on this page ───────────────── */
  .web-feature {
    margin-top: var(--space-6);
  }

  .web-bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--space-12);
    padding: var(--space-2) var(--space-4);
    border-bottom: var(--border-width) solid var(--border-default);
  }

  .web-bar__id {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .web-bar .platform {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--text-high-contrast);
  }

  .web-bar .host-badge {
    margin: 0;
  }

  .web-bar__url {
    justify-self: center;
    color: var(--text-muted);
    font-size: 12px;
  }

  .web-bar__live {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    color: var(--text-accent);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
  }

  .web-surface {
    position: relative;
    height: 460px;
    background: var(--color-offgray-1000);
  }

  .web-stage {
    position: absolute;
    inset: 0;
  }

  .web-stage iframe {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--color-offgray-1000);
  }

  .web-poster {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transition: opacity 150ms cubic-bezier(0.4, 0, 0.2, 1) 150ms;
  }

  .web-stage iframe[data-loaded="true"] + .web-poster {
    opacity: 0;
  }

  .web-stub {
    position: absolute;
    inset: 0;
  }

  .web-stub .web-poster {
    opacity: 0.5;
  }

  .web-stub-note {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    padding: var(--space-4);
    background: var(--info-bar-bg);
    color: var(--text-body);
    font-size: 13px;
  }

  .web-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4);
    border-top: var(--border-width) solid var(--border-default);
  }

  .web-meta .caption {
    max-width: 62ch;
  }

  .web-actions {
    flex: none;
  }

  @media (max-width: 979px) {
    .devices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 719px) {
    .web-surface {
      height: 360px;
    }

    .web-bar__url {
      display: none;
    }
  }

  @media (max-width: 519px) {
    .devices {
      grid-template-columns: 1fr;
    }
  }
</style>
