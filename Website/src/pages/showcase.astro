---
import "../styles/site.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteIcons from "../components/SiteIcons.astro";
import ThemeScript from "../components/ThemeScript.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (import.meta.env.SITE ?? "https://swifttui.sh").replace(/\/$/, "");
const canonical = `${site}${base || ""}/showcase/`;
const ogImage = `${site}${base || ""}/og.png`;
const title = "SwiftTUI Showcase";
const description =
  "Four production-quality apps built with SwiftTUI: a GIF editor, a terminal workspace, a side-by-side SwiftUI/SwiftTUI layout demo, and a git visualization CLI.";

type Tile = {
  slug: string;
  title: string;
  subtitle: string;
  body: string;
  repo: string;
};

const tiles: Tile[] = [
  {
    slug: "gifeditor",
    title: "GIF Editor",
    subtitle: "Canvas, layers, timeline, undo/redo — in the terminal.",
    body:
      "A full GIF editor written as ordinary SwiftTUI Views. Click tools, paint on a canvas, scrub a timeline, export an animated GIF. Proves that sophisticated desktop-class UX fits inside integer-cell rendering.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/gifeditor",
  },
  {
    slug: "terminal-workspace",
    title: "Terminal Workspace",
    subtitle: "Zellij-style tabs, splits, and a command palette.",
    body:
      "Multi-pane terminal workspace built on SwiftTUITerminalWorkspace. Persisted layouts, focused chrome, command palette, embedded pty sessions. The framework is large enough to host its own multiplexer.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/terminal-workspace",
  },
  {
    slug: "layouts-swiftui",
    title: "Layouts · side by side",
    subtitle: "Native SwiftUI on the left, SwiftTUI on the right.",
    body:
      "Visual proof of API parity: identical layout code rendering identical compositions in two substrates. Run the example, drag the split, watch them stay in lockstep as the geometry changes.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/LayoutsSwiftUI",
  },
  {
    slug: "gitviz",
    title: "gitviz",
    subtitle: "Every SwiftTUICharts primitive against a real repo.",
    body:
      "Seventeen subcommands rendering BarChart, LineChart, StackedBarChart, CalendarHeatmap, Sparkline, BulletChart, ThresholdGauge, Meter, and Timeline against the git history of whatever repo you point it at. Dashboards in a terminal.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/gitviz",
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="SwiftTUI logo over a dark marketing card" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0d1117" />
    <ThemeScript />
    <SiteIcons />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <SiteHeader />
    <main>
      <section class="showcase">
        <div class="shell">
          <header class="head">
            <span class="eyebrow mono"><span class="num">/00</span>Showcase</span>
            <h1>Built with SwiftTUI.</h1>
            <p class="lede">
              The framework already runs production-quality apps. These are
              maintained example apps in <span class="mono">swift-tui-examples</span> —
              clone the repo and they all build and run with one command.
            </p>
          </header>

          <ol class="grid">
            {tiles.map((t) => (
              <li class="tile">
                <a class="link" href={t.repo} rel="noreferrer noopener">
                  <div class="shot">
                    <img
                      src={`${base}/showcase/${t.slug}.svg`}
                      alt={`${t.title} screenshot`}
                      loading="lazy"
                      width="1200"
                      height="750"
                    />
                  </div>
                  <div class="meta">
                    <h2>{t.title}</h2>
                    <p class="sub">{t.subtitle}</p>
                    <p class="body">{t.body}</p>
                    <span class="cta mono">view source →</span>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .showcase { padding: 72px 0 96px; }
  .shell {
    max-width: var(--shell-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .head { max-width: 760px; margin-bottom: 48px; }
  .head .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-3);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .head .eyebrow .num { color: var(--accent); }
  .head h1 {
    font-size: 44px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 14px 0 0;
    color: var(--ink);
  }
  .head .lede {
    margin-top: 18px;
    max-width: 70ch;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.55;
  }
  .head .lede .mono { color: var(--ink); }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .tile {
    background: var(--panel);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .tile .link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .shot {
    aspect-ratio: 1200 / 750;
    overflow: hidden;
    background: var(--inset);
    border-bottom: 1px solid var(--line);
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .meta { padding: 22px 22px 24px; }
  .meta h2 {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.012em;
    margin: 0;
    color: var(--ink);
  }
  .meta .sub {
    color: var(--ink-2);
    font-size: 14px;
    margin: 6px 0 0;
  }
  .meta .body {
    color: var(--ink-3);
    font-size: 13.5px;
    line-height: 1.55;
    margin: 12px 0 0;
  }
  .meta .cta {
    display: inline-block;
    margin-top: 14px;
    font-size: 12px;
    color: var(--accent);
  }
  .tile:hover {
    border-color: var(--accent-dim);
    transform: translateY(-1px);
  }
  .tile:hover .cta { color: var(--accent); }

  @media (max-width: 920px) {
    .grid { grid-template-columns: 1fr; }
    .head h1 { font-size: 34px; }
  }
</style>
