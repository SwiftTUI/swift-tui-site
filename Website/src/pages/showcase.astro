---
import "../styles/site.css";
import "../styles/marketing.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteIcons from "../components/SiteIcons.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (import.meta.env.SITE ?? "https://swifttui.sh").replace(/\/$/, "");
const canonical = `${site}${base || ""}/showcase/`;
const ogImage = `${site}${base || ""}/og.png`;
const title = "SwiftTUI Showcase";
const description =
  "One SwiftTUI component gallery rendered by every host, and every maintained example app in swift-tui-examples you can clone and run.";

// Live WebExample embed. The whole origin is cross-origin isolated (public/_headers
// applies COOP/COEP to /*), so the iframe's SharedArrayBuffer-backed stdin works on
// this page exactly as it does on the homepage demo. In `astro dev` without a composed
// wasm artifact the route 404s, so fall back to the poster — mirrors DemoTerminal.
const isDev = import.meta.env.DEV;
const webExampleDir =
  process.env.WEBEXAMPLE_DIR ?? "../.build/public-inputs/swift-tui-counter-demo/WebExample";
const hasLocalWebExampleArtifact =
  existsSync(resolve(process.cwd(), webExampleDir, "pages-dist/index.html")) &&
  existsSync(
    resolve(process.cwd(), webExampleDir, "pages-dist/TerminalApp/dist/assets/app.wasm"),
  );
const showWebStub = isDev && !hasLocalWebExampleArtifact;
const webIframeSrc = `${base}/webexample/?embed=marketing`;
const webDemoHref = `${base}/webexample/`;
const webSourceHref =
  "https://github.com/SwiftTUI/swift-tui-counter-demo/tree/main/WebExample";

type Host = {
  slug: string;
  platform: string;
  host: string;
  body: string;
  href: string;
  img: string;
  preview?: boolean;
};

// The same gallery surface (GalleryDemoViews / gallery-demo), rendered by each host.
const hosts: Host[] = [
  {
    slug: "macos",
    platform: "macOS",
    host: "SwiftUIHost",
    body: "Retained inside a native SwiftUI window. Theme tokens swap at runtime; the authored views never branch on the host.",
    href: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/SwiftUIExample",
    img: `${base}/showcase/host-macos.png`,
  },
  {
    slug: "ios",
    platform: "iOS",
    host: "SwiftUIHost",
    body: "The same scenes in a native iOS app shell, with keyboard, pointer, and accessibility bridged into SwiftTUI input.",
    href: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/SwiftUIExample",
    img: `${base}/showcase/host-ios.png`,
  },
  {
    slug: "android",
    platform: "Android",
    host: "SwiftTUIAndroidHost",
    body: "Swift cross-compiled to arm64, painting styled cells and images on a Jetpack Compose Canvas through a JNI shim.",
    href: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/AndroidGallery",
    img: `${base}/showcase/host-android.png`,
  },
  {
    slug: "terminal",
    platform: "Terminal",
    host: "SwiftTUICLI",
    body: "The native substrate. ANSI / Kitty / Sixel negotiated against the live terminal, mouse and signals by default.",
    href: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/gallery",
    img: `${base}/showcase/host-terminal.png`,
  },
];

type Tile = {
  slug: string;
  title: string;
  subtitle: string;
  body: string;
  repo: string;
  img: string;
};

const tiles: Tile[] = [
  {
    slug: "gifeditor",
    title: "GIF Editor",
    subtitle: "Canvas, layers, timeline, undo/redo — in the terminal.",
    body:
      "A full GIF editor written as ordinary SwiftTUI Views. Click tools, paint on a canvas, scrub a timeline, export an animated GIF. Proves that sophisticated desktop-class UX fits inside integer-cell rendering.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/gifeditor",
    img: `${base}/showcase/gifeditor.png`,
  },
  {
    slug: "terminal-workspace",
    title: "Terminal Workspace",
    subtitle: "Zellij-style tabs, splits, and a command palette.",
    body:
      "Multi-pane terminal workspace built on SwiftTUITerminalWorkspace. Persisted layouts, focused chrome, command palette, embedded pty sessions. The framework is large enough to host its own multiplexer.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/terminal-workspace",
    img: `${base}/showcase/terminal-workspace.png`,
  },
  {
    slug: "git-viz",
    title: "git-viz",
    subtitle: "Every SwiftTUICharts primitive against a real repo.",
    body:
      "Seventeen subcommands rendering BarChart, ColumnChart, StackedBarChart, ComparisonChart, LineChart, Sparkline, Timeline, HeatStrip, CalendarHeatmap, BulletChart, ThresholdGauge, Meter, and Legend against the git history of whatever repo you point it at. Dashboards in a terminal.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/git-viz",
    img: `${base}/showcase/git-viz.png`,
  },
  {
    slug: "mrkdwn",
    title: "mrkdwn",
    subtitle: "Markdown as a responsive terminal document.",
    body:
      "A terminal Markdown reader built on swift-markdown: navigation, bounded search, theming, live reload on file changes, and inline images — shown here reading the SwiftTUI README.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/mrkdwn",
    img: `${base}/showcase/mrkdwn.png`,
  },
  {
    slug: "csvui",
    title: "csvui",
    subtitle: "A viewer-first CSV/TSV workbench.",
    body:
      "Indexes the source bytes once and decodes only the rows the viewport needs, so a 34,000-row GeoNames city table stays responsive. Sparse editing, search, filtering, sorting, file watching, and safe atomic saves.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/csvui",
    img: `${base}/showcase/csvui.png`,
  },
  {
    slug: "sextant",
    title: "Sextant",
    subtitle: "Miller-column file browsing with inline previews.",
    body:
      "Navigate directory columns with bounded text, binary, metadata, and directory previews, then open or edit the file when you have your bearing — here pointed at the swift-tui-examples checkout.",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/sextant",
    img: `${base}/showcase/sextant-browse.png`,
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="SwiftTUI logo over a dark marketing card" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="theme-color"
      content="#f5f7f3"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#101512"
      media="(prefers-color-scheme: dark)"
    />
    <ThemeScript />
    <SiteIcons />
  </head>
  <body class="marketing-subpage showcase-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <section class="showcase">
        <div class="shell">
          <header class="head">
            <span class="eyebrow mono"><span class="num">/00</span>Showcase</span>
            <h1>Built with SwiftTUI.</h1>
            <p class="lede">
              The framework already runs real, non-trivial apps — and runs the
              same one on every host. Below: one component gallery rendered five
              ways, then every maintained example app in{" "}
              <span class="mono">swift-tui-examples</span> you can clone and run
              with a single command.
            </p>
          </header>

          <!-- ── /01 · the same gallery, every host ──────────────────────── -->
          <section class="hosts" aria-labelledby="hosts-title">
            <header class="sub-head">
              <span class="eyebrow mono"><span class="num">/01</span>Every host</span>
              <h2 id="hosts-title">One gallery. Every host.</h2>
              <p class="sub-lede">
                These are not four apps — they are the{" "}
                <span class="mono">same</span> SwiftTUI component gallery, the
                same <span class="mono">View</span>s, handed to a different host.
                The framework owns the cells; each host owns its chrome. The
                host packages:{" "}
                <a href="https://github.com/SwiftTUI/swift-tui-swiftui" rel="noreferrer noopener"><span class="mono">swift-tui-swiftui</span></a>{" "}
                (macOS · iOS),{" "}
                <a href="https://github.com/SwiftTUI/swift-tui-android" rel="noreferrer noopener"><span class="mono">swift-tui-android</span></a>,
                and{" "}
                <a href="https://github.com/SwiftTUI/swift-tui-web" rel="noreferrer noopener"><span class="mono">swift-tui-web</span></a>{" "}
                (browser).
              </p>
            </header>

            <ul class="devices">
              {hosts.map((h) => (
                <li class="device">
                  <a class="device-link" href={h.href} rel="noreferrer noopener">
                    <div class="device-shot">
                      <img
                        src={h.img}
                        alt={`SwiftTUI gallery running on ${h.platform}`}
                        loading="lazy"
                        width="1000"
                        height="1000"
                      />
                      {h.preview && <span class="ribbon mono">preview</span>}
                    </div>
                    <div class="device-meta">
                      <div class="device-id">
                        <span class="platform">{h.platform}</span>
                        <span class="host-badge mono">{h.host}</span>
                      </div>
                      <p class="device-body">{h.body}</p>
                      <span class="cta mono">view example →</span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>

            <!-- the browser host, running live on this page -->
            <div class="web-feature">
              <div class="web-id">
                <span class="platform">Browser</span>
                <span class="host-badge mono">SwiftTUIWASI · @swifttui/web</span>
              </div>
              <div class="web-frame">
                <div class="web-bar">
                  <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
                  <span class="url mono">swifttui.sh/webexample</span>
                  <span class="live mono"><span class="live-dot"></span>live</span>
                </div>
                <div class="web-surface">
                  {showWebStub ? (
                    <div class="web-stub">
                      <img class="web-poster" src={`${base}/showcase/host-web.png`} alt="" aria-hidden="true" />
                      <p class="web-stub-note mono">
                        Live wasm demo composes in production. Run
                        <span class="mark"> bun run build:wasm:dev </span> in
                        <span class="mark"> Website/ </span> to mount it locally.
                      </p>
                    </div>
                  ) : (
                    <div class="web-stage">
                      <iframe
                        src={webIframeSrc}
                        title="SwiftTUI counter running as a WASI browser app"
                        loading="lazy"
                        referrerpolicy="same-origin"
                      ></iframe>
                      <img
                        class="web-poster"
                        src={`${base}/showcase/host-web.png`}
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                </div>
              </div>
              <div class="web-meta">
                <p class="device-body">
                  The shared counter <span class="mono">View</span>, built to
                  <span class="mono"> wasm32-wasi</span> and mounted on a canvas
                  through <span class="mono">@swifttui/web</span>, running right
                  here, no terminal emulator, no xterm.js.
                </p>
                <div class="web-actions mono">
                  <a class="solid" href={webDemoHref}>open full demo →</a>
                  <a class="ghost" href={webSourceHref} rel="noreferrer noopener">view source →</a>
                </div>
              </div>
            </div>
          </section>

          <!-- ── /02 · maintained example apps ───────────────────────────── -->
          <section class="examples" aria-labelledby="examples-title">
            <header class="sub-head">
              <span class="eyebrow mono"><span class="num">/02</span>Example apps</span>
              <h2 id="examples-title">Built in the open.</h2>
              <p class="sub-lede">
                Every maintained example app in{" "}
                <span class="mono">swift-tui-examples</span> — clone the repo and
                they all build and run with one command.
               The chart primitives in <span class="mono">git-viz</span>
                ship from{" "}
                <a href="https://github.com/SwiftTUI/swift-tui-charts" rel="noreferrer noopener"><span class="mono">swift-tui-charts</span></a>{" "}
                (<a href={`${base}/docs/charts/documentation/swifttuicharts/`}>charts DocC</a>).
              </p>
            </header>

            <ol class="grid">
              {tiles.map((t) => (
                <li class="tile">
                  <a class="link" href={t.repo} rel="noreferrer noopener">
                    <div class="shot">
                      <img
                        src={t.img}
                        alt={`${t.title} screenshot`}
                        loading="lazy"
                        width="1200"
                        height="750"
                      />
                    </div>
                    <div class="meta">
                      <h3>{t.title}</h3>
                      <p class="sub">{t.subtitle}</p>
                      <p class="body">{t.body}</p>
                      <span class="cta mono">view source →</span>
                    </div>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </section>
    </main>
    <SiteFooter />

    <script>
      // Fade each web poster out once its iframe paints, so the live demo
      // hands off cleanly from the static screenshot (same idiom as DemoTerminal).
      document.querySelectorAll(".web-stage iframe").forEach((frame) => {
        frame.addEventListener("load", () => frame.setAttribute("data-loaded", "true"));
      });
    </script>
  </body>
</html>

<style>
  .showcase {
    padding: 48px 0 96px;
  }

  .shell {
    max-width: var(--shell-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .head,
  .sub-head {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(280px, 0.88fr);
    column-gap: clamp(36px, 6vw, 88px);
    align-items: end;
  }

  .head {
    row-gap: 20px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--home-ink);
  }

  .eyebrow {
    display: inline-flex;
    grid-column: 1 / -1;
    align-items: center;
    gap: 8px;
    color: var(--home-accent-ink);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .eyebrow .num {
    color: var(--home-quiet);
  }

  .head h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--home-ink);
    font-size: clamp(42px, 5.3vw, 60px);
    font-weight: 520;
    line-height: 0.96;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .head .lede {
    max-width: 56ch;
    margin: 0;
    color: var(--home-muted);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .head .lede .mono,
  .sub-lede .mono {
    color: var(--home-ink);
  }

  /* ── section sub-headers ──────────────────────────────────────── */
  .sub-head {
    row-gap: 16px;
    margin-bottom: 28px;
  }

  .sub-head h2 {
    max-width: 17ch;
    margin: 0;
    color: var(--home-ink);
    font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 520;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .sub-lede {
    max-width: 58ch;
    margin: 0;
    color: var(--home-muted);
    font-size: 15px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hosts {
    padding: 32px 0 64px;
    border-bottom: 1px solid var(--home-ink);
  }

  .examples {
    padding-top: 32px;
  }

  /* ── host device band ─────────────────────────────────────────── */
  .devices {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--home-ink);
    border-left: 1px solid var(--home-ink);
    list-style: none;
  }

  .device {
    min-width: 0;
    border-right: 1px solid var(--home-ink);
    border-bottom: 1px solid var(--home-ink);
    background: var(--home-paper);
    overflow: hidden;
  }

  .device-link {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .device-shot {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-bottom: 1px solid var(--home-line);
    background: var(--home-paper-soft);
  }

  .device-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ribbon {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 8px;
    border: 1px solid #536158;
    border-radius: 3px;
    background: rgb(16 21 18 / 88%);
    color: #d5ddd7;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }

  .device-meta {
    display: flex;
    min-height: 192px;
    flex-direction: column;
    padding: 18px;
    transition: background 140ms ease;
  }

  .device-id {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .platform {
    color: var(--home-ink);
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .host-badge {
    color: var(--home-quiet);
    font-size: 10.5px;
  }

  .device-body {
    margin: 9px 0 0;
    color: var(--home-muted);
    font-size: 12.5px;
    line-height: 1.55;
  }

  .cta {
    display: inline-block;
    align-self: flex-start;
    margin-top: auto;
    padding-top: 16px;
    border-bottom: 1px solid var(--home-line-strong);
    color: var(--home-accent-ink);
    font-size: 12px;
  }

  .device:hover .device-meta,
  .tile:hover .meta {
    background: var(--home-paper-soft);
  }

  .device:hover .cta,
  .tile:hover .cta {
    border-color: var(--home-accent);
  }

  /* ── live web feature ─────────────────────────────────────────── */
  .web-feature {
    margin-top: 20px;
    border: 1px solid var(--home-ink);
    background: var(--home-paper);
  }

  .web-id {
    display: flex;
    min-height: 54px;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--home-accent);
    color: var(--home-accent-on);
  }

  .web-id .platform,
  .web-id .host-badge {
    color: inherit;
  }

  .web-id .host-badge {
    opacity: 0.78;
  }

  .web-frame {
    border-top: 1px solid var(--home-ink);
    border-bottom: 1px solid var(--home-ink);
    background: var(--term-bg);
    overflow: hidden;
  }

  .web-bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    min-height: 38px;
    padding: 6px 14px;
    border-bottom: 1px solid #2a342d;
    background: #101512;
  }

  .web-bar .dots {
    display: inline-flex;
    gap: 7px;
  }

  .web-bar .dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #536158;
  }

  .web-bar .dots span:nth-child(1) { background: var(--term-red); }
  .web-bar .dots span:nth-child(2) { background: var(--term-yellow); }
  .web-bar .dots span:nth-child(3) { background: var(--term-green); }

  .web-bar .url {
    justify-self: center;
    color: #a0aca3;
    font-size: 12px;
  }

  .web-bar .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--home-terminal-accent);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .web-bar .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--home-terminal-accent);
    box-shadow: 0 0 0 3px rgb(98 214 191 / 16%);
  }

  .web-surface {
    position: relative;
    height: 460px;
    background: var(--home-paper);
  }

  .web-stage {
    position: absolute;
    inset: 0;
  }

  .web-stage iframe {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--home-paper);
  }

  .web-poster {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    pointer-events: none;
    transition: opacity 220ms ease 140ms;
  }

  .web-stage iframe[data-loaded="true"] + .web-poster { opacity: 0; }

  .web-stub {
    position: absolute;
    inset: 0;
  }

  .web-stub .web-poster { z-index: 0; opacity: 0.5; }

  .web-stub-note {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    margin: 0;
    padding: 14px 18px;
    background: linear-gradient(180deg, transparent, rgb(16 21 18 / 94%));
    color: #d5ddd7;
    font-size: 12px;
  }

  .web-stub-note .mark {
    padding: 1px 4px;
    border: 1px solid #536158;
    border-radius: 3px;
    background: #151c17;
    color: #e8eee9;
  }

  .web-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 18px;
    flex-wrap: wrap;
  }

  .web-meta .device-body { max-width: 62ch; margin: 0; font-size: 13.5px; }

  .web-actions {
    display: inline-flex;
    flex-shrink: 0;
    gap: 8px;
  }

  .web-actions a {
    padding: 8px 13px;
    border-radius: 3px;
    font-size: 12px;
    transition: border-color 160ms ease, color 160ms ease, background 160ms ease;
  }

  .web-actions .solid {
    border: 1px solid var(--home-ink);
    background: var(--home-ink);
    color: var(--home-paper);
  }

  .web-actions .solid:hover {
    border-color: var(--home-accent);
    background: var(--home-accent);
    color: var(--home-accent-on);
  }

  .web-actions .ghost {
    border: 1px solid var(--home-line-strong);
    color: var(--home-muted);
  }

  .web-actions .ghost:hover {
    border-color: var(--home-accent);
    background: var(--home-paper-soft);
    color: var(--home-ink);
  }

  /* ── example app grid ─────────────────────────────────────────── */
  .grid {
