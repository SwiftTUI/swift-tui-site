---
import Site from "../../layouts/Site.astro";
import Section from "../../components/Section.astro";
import { getPublishedUpdates, updatePath } from "../../lib/updates";
import "../../styles/updates.css";

const updates = await getPublishedUpdates();
---

<Site
  title="Updates · SwiftTUI"
  description="Authored release stories and closer looks at SwiftTUI."
  path="/updates/"
  mainClass="updates"
>
  <Section as="header" class="updates-intro">
    <p class="eyebrow eyebrow--accent">From the project</p>
    <h1>Updates</h1>
    <p class="lead">Release stories and closer looks at what is changing in SwiftTUI.</p>
    <a class="link updates-rss" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/updates/rss.xml`}>
      Subscribe via RSS ↗
    </a>
  </Section>
  <Section class="updates-list" aria-label="Posts">
    {updates.map((post) => (
      <article class="updates-item">
        <div class="updates-item__meta">
          <span>{post.data.kind}</span>
          <time datetime={post.data.published.toISOString()}>
            {post.data.published.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
          </time>
        </div>
        <h2><a href={updatePath(post.id)}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <a class="link updates-item__read" href={updatePath(post.id)} aria-label={`Read ${post.data.title}`}>
          Read update →
        </a>
      </article>
    ))}
  </Section>
</Site>
