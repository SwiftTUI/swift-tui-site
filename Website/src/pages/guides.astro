---
import Site from "../layouts/Site.astro";
import CodeSnippet from "../components/CodeSnippet.astro";
import Button from "../components/Button.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import pkg from "../../package.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "SwiftTUI documentation";
const description =
  "SwiftTUI's documentation, organized by task: the first-hour path, the reference guides for views, state, and focus, charts, what lies beyond the terminal, and the module-by-module API reference.";

// Deep links into the composed DocC archives, built from current source.
// Guides are organized here by task; the
// archive itself is organized by module.
const docs = `${base}/docs/documentation`;
const charts = `${base}/docs/charts/documentation/swifttuicharts`;
const terminalView = `${base}/docs/terminal-view/documentation/swifttuiterminalview`;

// The first hour starts with the toolchain and package setup on this page.
const firstHour = [
  {
    href: `${base}/guides/#toolchain`,
    title: "Add it to your app",
    copy: "Pick a toolchain, add the package, paste the counter, swift run.",
  },
  {
    href: `${docs}/swifttuiviews/authoring-views`,
    title: "Authoring Views",
    copy: "Compose containers, local state, focused controls, and modifiers around a body-driven tree.",
  },
  {
    href: `${docs}/swifttuiviews/state-environment-and-focus`,
    title: "State, Environment, and Focus",
    copy: "State, observation, environment, and focus share one runtime invalidation path.",
  },
  {
    href: `${docs}/swifttuiruntime/running-apps`,
    title: "Running Apps",
    copy: "The @main entry point, the standard flags, exit keys, and rendering one frame without a TTY.",
  },
  {
    href: `${docs}/swifttuiviews/coming-from-swiftui`,
    title: "Coming from SwiftUI",
    copy: "What transfers unchanged, which reflexes need retraining, and what is not here yet.",
  },
];

const packageSource = `// swift-tools-version: 6.4
import PackageDescription

let package = Package(
  name: "MyTerminalApp",
  platforms: [.macOS(.v15)],
  dependencies: [
    .package(
      url: "https://github.com/SwiftTUI/swift-tui",
      .upToNextMinor(from: "${pkg.version}")
    ),
  ],
  targets: [
    .executableTarget(
      name: "MyTerminalApp",
      dependencies: [
        .product(name: "SwiftTUI", package: "swift-tui"),
      ]
    ),
  ]
)`;

const buildGuides = [
  {
    href: `${docs}/swifttuiviews/forms-and-controls`,
    title: "Forms and Controls",
    copy: "Compose buttons, pickers, toggles, sliders, and text entry into a working form.",
  },
  {
    href: `${docs}/swifttuiviews/commands-and-key-input`,
    title: "Commands and Key Input",
    copy: "Focus-scoped arrows and Escape, keyboard shortcuts, submit actions, and command palettes.",
  },
  {
    href: `${docs}/swifttuiviews/scrolling`,
    title: "Scrolling",
    copy: "Finite viewports, compositional lazy stacks, nested wheel routing, indicators, and scrolling from code.",
  },
  {
    href: `${docs}/swifttuiviews/animating-views`,
    title: "Animating Views",
    copy: "State animation, default fades, numeric text, nested matched geometry, keyframes, and reduced motion.",
  },
  {
    href: `${docs}/swifttuiviews/navigation-and-tabs`,
    title: "Navigation and Tabs",
    copy: "Typed navigation paths, destinations, tab selection, and view lifetime.",
  },
  {
    href: `${docs}/swifttuianimatedimage`,
    title: "Animated Images and GIFs",
    copy: "Decode and author frames, control finite or continuous playback, and preserve GIF loop metadata on export.",
  },
  {
    href: `${docs}/swifttuiviews/style-system`,
    title: "The Style System",
    copy: "All 28 open style families in one place: built-ins, scoping, custom conformances, routes, theming, diagnostics, and tests.",
  },
  {
    href: `${docs}/swifttuiviews/styling-and-theming`,
    title: "Styling and Theming",
    copy: "Colors, semantic roles, gradients, the theme model, and your first custom button style.",
  },
  {
    href: `${docs}/swifttuiviews/authoring-styles`,
    title: "Authoring Styles",
    copy: "The contract every style family shares: body-producing and presentation-value styles, route wrappers, and what a style may change.",
  },
  {
    href: `${docs}/swifttuiviews/testing-styles`,
    title: "Testing Styles",
    copy: "Exercise custom styles with fixture configurations, snapshots, and runtime route checks.",
  },
  {
    href: `${docs}/swifttuiviews/focus`,
    title: "Understanding Focus",
    copy: "The runtime focus model for input routing, state control, and context export.",
  },
  {
    href: `${docs}/swifttuiviews/collections`,
    title: "Lists and Tables",
    copy: "Collections with authored row content, selection, and viewport-backed data sources.",
  },
  {
    href: `${docs}/swifttuiviews/geometry-and-preferences`,
    title: "Geometry and Preferences",
    copy: "Anchor preferences let a subtree publish geometry that other views resolve after layout.",
  },
  {
    href: `${docs}/swifttuiviews/shapes`,
    title: "Shapes",
    copy: "Arcs and angles, fills and strokes, shape clipping, and compatible-topology path animation.",
  },
  {
    href: `${docs}/swifttuiviews/aspectcorrectshapes`,
    title: "Aspect-correct shapes",
    copy: "Cell pixel metrics keep circles circular across terminal fonts and hosts.",
  },
  {
    href: `${docs}/swifttuiviews/pointer-and-canvas`,
    title: "Pointer and Canvas",
    copy: "One continuous cell coordinate space for gestures, hover, and drawing.",
  },
  {
    href: `${docs}/swifttuiviews/accessibility`,
    title: "Accessibility",
    copy: "Semantic metadata for terminal screen readers, browser ARIA trees, VoiceOver, and TalkBack.",
  },
  {
    href: `${docs}/swifttuiviews/custom-dynamic-properties`,
    title: "Custom Dynamic Properties",
    copy: "Build your own property wrappers on the DynamicProperty extension point.",
  },
  {
    href: `${docs}/swifttuiviews/state-keying`,
    title: "State Keying",
    copy: "How @State storage is keyed across evaluations, and where owners survive lazy seams.",
  },
  {
    href: `${docs}/swifttuiviews/dormant-tab-state`,
    title: "Dormant Tab State",
    copy: "What happens to a tab's persistent state while the tab is not selected.",
  },
  {
    href: `${docs}/swifttuiviews/dismissal-is-data`,
    title: "Dismissal Is Data",
    copy: "Presentations are driven by Boolean bindings and identifiable items, not hidden stacks.",
  },
];

// Terminal-side runtime reference: what an app reads and does once it is
// running. Kept separate from the host guides so "beyond the terminal" stays
// one clearly labeled group.
const runtimeGuides = [
  {
    href: `${docs}/swifttuiruntime/performance-for-app-authors`,
    title: "Performance for App Authors",
    copy: "Stable identity, certified memo reuse, lazy content, and a measurement-led profiling workflow.",
  },
  {
    href: `${docs}/swifttuiruntime/logging-and-diagnostics`,
    title: "Logging and Diagnostics",
    copy: "Safe logging while the app owns the screen, runtime issues, traces, and debug bundles.",
  },
  {
    href: `${docs}/swifttui/testing-your-app`,
    title: "Testing Your App",
    copy: "Render deterministic frames without a TTY and test state, layout, and interaction.",
  },
  {
    href: `${docs}/swifttui/distributing-your-app`,
    title: "Distributing Your App",
    copy: "Package a native executable, standard flags, shell completions, and platform requirements.",
  },
  {
    href: `${docs}/swifttuiruntime/environment-variables`,
    title: "Environment Variables",
    copy: "Every SWIFTTUI_* environment variable the framework reads, grouped by subsystem.",
  },
  {
    href: `${docs}/swifttuiruntime/terminal-handoffs`,
    title: "Terminal Handoffs",
    copy: "Temporarily hand the interactive terminal back to the user's shell mid-run.",
  },
  {
    href: `${docs}/swifttuiruntime/terminalembedding`,
    title: "Terminal Embedding",
    copy: "Host external terminal programs with SwiftTUITerminalView from the separate terminal-view package.",
  },
];

// Beyond the terminal, WASI → web first, then native hosts, then the product
// matrix for narrower builds. Host caveats live in these articles and on the
// host repos, not on this hub.
const hostGuides = [
  {
    href: `${docs}/swifttuiviews/adapting-to-hosts`,
    title: "Adapting an Interface to Its Host",
    copy: "One shared tree with touch targets, keyboard access, navigation, and scrolling suited to its host.",
  },
  {
    href: `${docs}/swifttuiwasi/deploying-to-the-browser`,
    title: "Deploying to the Browser",
    copy: "Serve a local app with --web or publish a static WASI bundle with the browser host packages.",
  },
  {
    href: "https://github.com/SwiftTUI/swift-tui-swiftui#readme",
    title: "Embedding in SwiftUI",
    copy: "Native macOS and iOS hosting, touch panning, text input, and optional keyboard controls.",
  },
  {
    href: `${docs}/swifttuiruntime/hosts-and-platforms`,
    title: "Hosts and Platforms",
    copy: "The browser (--web and static WASI bundles), native SwiftUI windows, and Android, with the support matrix.",
  },
  {
    href: `${docs}/swifttuiruntime/host-integration`,
    title: "Runner and Host Integration",
    copy: "How apps launch through runner products or live inside host products.",
  },
  {
    href: `${docs}/swifttui/choosing-modules-and-platforms`,
    title: "Choosing Modules and Platforms",
    copy: "One dependency and one import for most apps, plus the product matrix when you need a narrower build.",
  },
];

const conceptLinks = [
  {
    href: `${base}/capabilities/`,
    title: "What You Can Build",
    copy: "Drawing, animation, scrolling workspaces, and interaction, with examples and links into the guides.",
  },
  {
    href: "https://github.com/SwiftTUI/swift-tui/blob/main/docs/PUBLIC_MODULE_MAP.md",
    title: "Public Module Map",
    copy: "Generated product ownership, supported direct imports, and transitive re-exports from source.",
  },
  {
    href: `${base}/differences-from-swiftui/`,
    title: "Differences from SwiftUI",
    copy: "The primer: what transfers, and the deliberate terminal-native rereadings.",
  },
  {
    href: `${base}/pipeline/`,
    title: "Under the hood",
    copy: "An interactive walkthrough of the frame pipeline, from body to terminal cells.",
  },
  {
    href: `${docs}/swifttuiruntime/runtime-render-pipeline`,
    title: "Runtime Render Pipeline",
    copy: "The developer-level reference for the same pipeline: phases, products, and commit policy.",
  },
  {
    href: `${docs}/swifttuiruntime/vision`,
    title: "About SwiftTUI",
    copy: "Why the framework exists and what it optimizes for.",
  },
  {
    href: `${docs}/swifttuiviews/divergences-and-gaps`,
    title: "Divergences and gaps",
    copy: "The public register of API departures from SwiftUI and known gaps at HEAD.",
  },
];

// Module tiers for the API reference. The everyday tier is what app code
// imports; the hosts tier is per-deployment. The engine/vocabulary modules
// (Primitives, Graph, Core) are not published to the hosted site — their
// re-exported vocabulary is reached through the modules that export it.
const everydayModules = [
  { href: `${docs}/swifttui`, name: "SwiftTUI", copy: "the batteries-included app product" },
  { href: `${docs}/swifttuiviews`, name: "SwiftTUIViews", copy: "views, controls, layout, state, focus" },
  { href: `${docs}/swifttuiruntime`, name: "SwiftTUIRuntime", copy: "scenes, run loop, host integration" },
  { href: charts, name: "SwiftTUICharts", copy: "charts and compact metrics" },
  { href: terminalView, name: "SwiftTUITerminalView", copy: "embedded terminal program panes" },
];

const hostModules = [
  { href: `${docs}/swifttuicli`, name: "SwiftTUICLI", copy: "terminal-only runner" },
  { href: `${docs}/swifttuiwebhostcli`, name: "SwiftTUIWebHostCLI", copy: "terminal runner with --web" },
  { href: `${docs}/swifttuiarguments`, name: "SwiftTUIArguments", copy: "SwiftTUIOptions and command parsing" },
  { href: `${docs}/swifttuiwebhost`, name: "SwiftTUIWebHost", copy: "localhost browser host" },
  { href: `${docs}/swifttuiwasi`, name: "SwiftTUIWASI", copy: "WASI and browser builds" },
  { href: `${docs}/swifttuiandroidhost`, name: "SwiftTUIAndroidHost", copy: "Android embedding" },
  { href: `${docs}/swifttuianimatedimage`, name: "SwiftTUIAnimatedImage", copy: "animated GIF and image views" },
  { href: `${docs}/swifttuiprofiling`, name: "SwiftTUIProfiling", copy: "opt-in profiling and diagnostics" },
  {
    href: "https://github.com/SwiftTUI/swift-tui-swiftui",
    name: "SwiftUIHost",
    copy: "native SwiftUI embedding (separate package)",
    external: true,
  },
];

---

<Site
  title={title}
  description={description}
  path="/guides/"
  ogImageAlt="SwiftTUI documentation"
  twitterCard="summary"
  bodyClass="guides-page"
>
  <Section id="docs-top" aria-labelledby="docs-title">
    <SectionHead id="docs-title" level={1} eyebrow="Documentation">
      <Fragment slot="title">SwiftTUI documentation</Fragment>
      Organized by what you're doing: your first hour, then the reference
      guides for views, state, and focus, charts, and what lies beyond the
      terminal. The module-by-module API reference is at the end.
    </SectionHead>
    <div class="button-row">
      <Button href={`${base}/#get-started`} variant="primary">Get started</Button>
      <Button href={`${docs}/`} variant="secondary" trailingIcon="chevronRight">
        Open the API reference
      </Button>
    </div>
  </Section>

  <Section id="first-hour" aria-labelledby="first-hour-title">
    <SectionHead id="first-hour-title">
      <Fragment slot="title">Your first hour</Fragment>
      Read these in order. Each one picks up where the last left off, from an
      empty package to an app that handles state, focus, and the terminal's
      own rules.
    </SectionHead>
    <ol class="step-grid">
      {
        firstHour.map((card, index) => (
          <li>
            <a class="swifttui-card doc-card doc-card--step" href={card.href}>
              <div class="swifttui-card__body">
                <span class="step-index eyebrow eyebrow--accent">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="swifttui-card__title">{card.title}</h3>
                <p class="swifttui-card__desc">{card.copy}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="toolchain" aria-labelledby="toolchain-title">
    <SectionHead id="toolchain-title" eyebrow="Setup / Swift 6.4">
      <Fragment slot="title">A toolchain and an executable package.</Fragment>
      You can build from the command line on macOS, Linux, or Windows. Choose a Swift 6.4 toolchain before you begin.
    </SectionHead>
    <div class="toolchain-grid prose">
      <div><h3>macOS or Linux</h3><p>Install Swift with <a href="https://www.swift.org/swiftly/" rel="noreferrer noopener">swiftly</a>. On macOS, an Xcode installation with Swift 6.4 also works.</p></div>
      <div><h3>Windows</h3><p>Follow the <a href="https://www.swift.org/install/windows/" rel="noreferrer noopener">Swift installation guide</a> for the toolchain and its required build tools.</p></div>
    </div>
    <ol class="setup-steps prose">
      <li>Run <code>swift --version</code> to check your active toolchain.</li>
      <li>In a new <code>MyTerminalApp</code> directory, run <code>swift package init --type executable</code>.</li>
      <li>Replace <code>Package.swift</code> with the manifest below.</li>
      <li>Replace the generated executable source with the <a href={`${base}/#demo`}>complete counter example</a>. Save it as <code>Sources/MyTerminalApp/CounterApp.swift</code> and remove the generated entry-point file, so only the counter’s <code>@main</code> remains.</li>
      <li>Run <code>swift run</code>. Your app is ready for the next guide.</li>
    </ol>
    <CodeSnippet id="starter-package" label="Package.swift" code={packageSource} />
    <p class="setup-next prose">Then read <a href={`${docs}/swifttuiviews/authoring-views`}>Authoring Views</a>, or <a href={`${base}/#get-started`}>run the maintained counter directly</a>.</p>
  </Section>

  <Section id="build" aria-labelledby="build-title">
    <SectionHead id="build-title">
      <Fragment slot="title">Build your interface</Fragment>
      Views, controls, drawing, and animated images. Read the guides as you
      need them.
    </SectionHead>
    <div class="card-grid">
      {
        buildGuides.map((guide) => (
          <a class="swifttui-card doc-card" href={guide.href}>
            <div class="swifttui-card__body">
              <h3 class="swifttui-card__title">{guide.title}</h3>
              <p class="swifttui-card__desc">{guide.copy}</p>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <Section id="charts" aria-labelledby="charts-title">
    <SectionHead id="charts-title">
      <Fragment slot="title">Charts</Fragment>
      Sparklines, bar and line charts, heatmaps, meters, and calendar views
      ship separately as{" "}
      <a class="link" href="https://github.com/SwiftTUI/swift-tui-charts" rel="noreferrer noopener">
        <code>swift-tui-charts</code></a>, composed on the same view surface.
    </SectionHead>
    <div class="card-grid">
      <a class="swifttui-card doc-card" href={`${charts}/building-dashboards`}>
        <div class="swifttui-card__body">
          <h3 class="swifttui-card__title">Building Dashboards</h3>
          <p class="swifttui-card__desc">The charts guide: layout, scales, live data, and thresholds.</p>
        </div>
      </a>
      <a class="swifttui-card doc-card" href={charts}>
        <div class="swifttui-card__body">
          <h3 class="swifttui-card__title">SwiftTUICharts reference</h3>
          <p class="swifttui-card__desc">Every chart view and support type, in its own DocC archive.</p>
        </div>
      </a>
      <a class="swifttui-card doc-card" href={`${base}/showcase/`}>
        <div class="swifttui-card__body">
          <h3 class="swifttui-card__title">Charts in the showcase</h3>
          <p class="swifttui-card__desc">Every charting primitive exercised against a real repository.</p>
        </div>
      </a>
    </div>
  </Section>

  <Section id="run" aria-labelledby="run-title">
    <SectionHead id="run-title">
      <Fragment slot="title">At run time</Fragment>
      What a running terminal app reads and can do, from the{" "}
      <code>SwiftTUIRuntime</code> catalog.
    </SectionHead>
    <div class="card-grid">
      {
        runtimeGuides.map((guide) => (
          <a class="swifttui-card doc-card" href={guide.href}>
            <div class="swifttui-card__body">
              <h3 class="swifttui-card__title">{guide.title}</h3>
              <p class="swifttui-card__desc">{guide.copy}</p>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <Section id="beyond" aria-labelledby="beyond-title">
    <SectionHead id="beyond-title">
      <Fragment slot="title">Beyond the terminal</Fragment>
      Terminal first, not terminal only. The same app runs in a browser, inside
      native SwiftUI windows, and on Android; these guides own that path and
      its platform notes.
    </SectionHead>
    <div class="card-grid">
      {
        hostGuides.map((guide) => (
          <a class="swifttui-card doc-card" href={guide.href}>
            <div class="swifttui-card__body">
              <h3 class="swifttui-card__title">{guide.title}</h3>
              <p class="swifttui-card__desc">{guide.copy}</p>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <Section id="concepts" aria-labelledby="concepts-title">
    <SectionHead id="concepts-title">
      <Fragment slot="title">Concepts and background</Fragment>
    </SectionHead>
    <div class="card-grid">
      {
        conceptLinks.map((link) => (
          <a class="swifttui-card doc-card" href={link.href}>
            <div class="swifttui-card__body">
              <h3 class="swifttui-card__title">{link.title}</h3>
              <p class="swifttui-card__desc">{link.copy}</p>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <Section id="reference" aria-labelledby="reference-title">
    <SectionHead id="reference-title">
      <Fragment slot="title">API reference by module</Fragment>
      The <a class="link" href={`${docs}/`}>combined DocC archive</a> documents
      each module. Most app code touches only the first row.
    </SectionHead>
    <div class="module-tiers">
      <div class="module-tier">
        <h3 class="eyebrow">What you import</h3>
        <ul>
          {
            everydayModules.map((m) => (
              <li>
                <a href={m.href} class="mono">{m.name}</a>
                <span> — {m.copy}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="module-tier">
        <h3 class="eyebrow">Hosts and opt-in products</h3>
        <ul>
          {
            hostModules.map((m) => (
              <li>
                <a href={m.href} class="mono" rel={m.external ? "noreferrer noopener" : undefined}>{m.name}</a>
                <span> — {m.copy}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="caption reference-note">
      The last group declares types that reach app code through re-export:{" "}
      <code>CellSize</code>, <code>Alignment</code>, <code>PreferenceKey</code>,{" "}
      <code>SwiftTUIOptions</code>. Their pages document symbols you use, behind
      imports you never write.
    </p>
  </Section>
</Site>

<style>
  .toolchain-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .toolchain-grid h3 { font-size: var(--card-title-size); margin-bottom: var(--space-2); }
  .setup-steps { margin-block: var(--space-6); padding-left: var(--space-6); display: grid; gap: var(--space-3); }
  .setup-next { margin-top: var(--space-4); }
  @media (max-width: 639px) { .toolchain-grid { grid-template-columns: minmax(0, 1fr); } }
  .step-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .step-grid li {
    min-width: 0;
  }

  .doc-card {
    height: 100%;
  }

  .doc-card .swifttui-card__body {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .doc-card .swifttui-card__desc {
    margin: 0;
  }

  .step-index {
    margin-bottom: var(--space-1);
  }

  .module-tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .module-tier h3 {
    margin-bottom: var(--space-3);
  }

  .module-tier ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .module-tier li {
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: -0.025em;
    color: var(--text-body);
  }

  .module-tier a {
    color: var(--text-high-contrast);
    font-size: 13px;
    letter-spacing: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--divider-accent);
  }

  .module-tier a:hover {
    text-decoration-style: double;
    text-decoration-color: var(--text-accent);
  }

  .reference-note {
    max-width: 68ch;
    margin-top: var(--space-6);
    color: var(--text-muted);
  }
</style>
