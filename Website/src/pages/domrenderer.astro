---
import Site from "../layouts/Site.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import "@swifttui/web/style.css";
---

<Site title="SwiftTUI experimental DOM renderer" description="The SwiftTUI counter presented as browser text with the experimental DOM renderer." path="/domrenderer">
  <Section>
    <SectionHead level={1} eyebrow="Experimental browser host">
      <span slot="title">The counter as browser text</span>
      The same Swift application and WASM artifact as the canvas demo, presented through DOM cells.
    </SectionHead>
    <p>The DOM renderer is experimental. <a href="https://github.com/SwiftTUI/swift-tui-web/tree/main/packages/web#renderers">Read the setup guide and current limits.</a></p>
    <p>Use browser zoom to enlarge the text. Hold Alt/Option and drag to select and copy the visible application text.</p>
    <nav data-domrenderer-scenes aria-label="Application scenes"></nav>
    <p data-domrenderer-status role="status">Loading the application…</p>
    <div class="domrenderer-viewport">
      <div data-domrenderer-mount aria-label="SwiftTUI counter"></div>
    </div>
  </Section>
</Site>

<script>
  import "../scripts/domrenderer-mount";
</script>

<style>
  .domrenderer-viewport {
    width: 100%;
    min-width: 0;
    height: var(--demo-canvas-height);
    overflow: hidden;
    margin-block: var(--space-8);
  }
  [data-domrenderer-mount] { height: 100%; }
  [data-domrenderer-scenes] { display: flex; flex-wrap: wrap; gap: var(--space-2); }
</style>
