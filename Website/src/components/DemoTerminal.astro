---
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const iframeSrc = `${base}/webexample/?embed=marketing`;
const webExampleHref = `${base}/webexample/`;
const sourceHref =
  "https://github.com/SwiftTUI/swift-tui-counter-demo/tree/main/WebExample";
const isDev = import.meta.env.DEV;
const webExampleDir =
  process.env.WEBEXAMPLE_DIR ??
  "../.build/public-inputs/swift-tui-counter-demo/WebExample";
const hasLocalArtifact =
  existsSync(resolve(process.cwd(), webExampleDir, "pages-dist/index.html")) &&
  existsSync(
    resolve(
      process.cwd(),
      webExampleDir,
      "pages-dist/TerminalApp/dist/assets/app.wasm",
    ),
  );
const showDevFallback = isDev && !hasLocalArtifact;

interface Props {
  id?: string;
}

const { id = "demo" } = Astro.props;
---

<section class="demo" id={id} aria-label="Live SwiftTUI counter">
  <header class="demo-header">
    <div>
      <strong>SwiftTUI app</strong>
      <span>Compiled for browser with SwiftTUIWASI</span>
    </div>
    <a href={webExampleHref}>Open separately</a>
  </header>

  {
    showDevFallback ? (
      <div class="demo-fallback" role="status">
        <p class="fallback-label">Local WASI artifact not built</p>
        <strong>The counter is composed during the full site build.</strong>
        <p>
          Run <code>bun run build:wasm:dev</code> in <code>Website/</code>,
          then reload this page.
        </p>
        <a href={sourceHref} rel="noreferrer noopener">
          Inspect the browser host source
        </a>
      </div>
    ) : (
      <swift-tui-demo data-src={iframeSrc}>
        <iframe
          title="SwiftTUI CounterApp running through the WASI browser host"
          referrerpolicy="same-origin"
          tabindex="0"
        />

        <div class="demo-state demo-state--idle" data-state-view="idle">
          <p>Run the exact source shown beside this frame.</p>
          <button type="button" data-load-demo>Load live counter</button>
        </div>

        <div
          class="demo-state demo-state--loading"
          data-state-view="loading"
          hidden
          role="status"
          aria-live="polite"
        >
          <span class="loading-mark" aria-hidden="true"></span>
          <p>Starting the WASI runtime</p>
        </div>

        <div
          class="demo-state demo-state--error"
          data-state-view="error"
          hidden
          role="alert"
        >
          <strong>The live frame did not start.</strong>
          <p>The source and static site remain available.</p>
          <div>
            <button type="button" data-retry-demo>Retry</button>
            <a href={sourceHref} rel="noreferrer noopener">View source</a>
          </div>
        </div>

      </swift-tui-demo>
    )
  }

  <footer class="demo-footer">
    <span>Real SwiftTUI view</span>
    <span>Static WASI bundle</span>
    <span>Canvas with sibling accessibility tree</span>
  </footer>
</section>

<script>
  class SwiftTUIDemo extends HTMLElement {
    private frame: HTMLIFrameElement;
    private timeout: number | undefined;
    private observer: IntersectionObserver | undefined;
    private started = false;

    constructor() {
      super();
      const frame = this.querySelector("iframe");
      if (!(frame instanceof HTMLIFrameElement)) {
        throw new Error("SwiftTUI demo iframe is missing");
      }
      this.frame = frame;
    }

    connectedCallback() {
      this.querySelector("[data-load-demo]")?.addEventListener("click", () =>
        this.start(),
      );
      this.querySelector("[data-retry-demo]")?.addEventListener("click", () =>
        this.retry(),
      );
      window.addEventListener("message", this.onMessage);

      if ("IntersectionObserver" in window) {
        this.observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) this.start();
          },
          { threshold: 0.2 },
        );
        this.observer.observe(this);
      }
    }

    disconnectedCallback() {
      window.removeEventListener("message", this.onMessage);
      this.observer?.disconnect();
      if (this.timeout !== undefined) window.clearTimeout(this.timeout);
    }

    private onMessage = (event: MessageEvent) => {
      if (
        event.origin !== window.location.origin ||
        event.source !== this.frame.contentWindow ||
        event.data?.type !== "swifttui-demo-ready"
      ) {
        return;
      }
      if (this.timeout !== undefined) window.clearTimeout(this.timeout);
      this.setState("ready");
    };

    private start() {
      if (this.started) return;
      this.started = true;
      this.observer?.disconnect();
      this.setState("loading");
      this.frame.src = this.dataset.src ?? "";
      this.timeout = window.setTimeout(() => this.setState("error"), 25_000);
    }

    private retry() {
      if (this.timeout !== undefined) window.clearTimeout(this.timeout);
      this.started = false;
      this.frame.removeAttribute("src");
      this.start();
    }

    private setState(state: "idle" | "loading" | "ready" | "error") {
      this.dataset.state = state;
      this.querySelectorAll<HTMLElement>("[data-state-view]").forEach((view) => {
        view.hidden = view.dataset.stateView !== state;
      });
    }
  }

  if (!customElements.get("swift-tui-demo")) {
    customElements.define("swift-tui-demo", SwiftTUIDemo);
  }
</script>

<style>
  .demo {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-height: 100%;
    background: #101512;
    color: #e8eee9;
  }

  .demo-header,
  .demo-footer {
    font-family: var(--font-mono);
  }

  .demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 60px;
    padding: 10px 15px;
    border-bottom: 1px solid #2a342d;
  }

  .demo-header > div {
    display: grid;
    gap: 2px;
  }

  .demo-header strong,
  .demo-header span,
  .demo-header a {
    font-size: 11px;
  }

  .demo-header strong {
    color: #f4f8f5;
    font-weight: 600;
  }

  .demo-header span {
    color: #89968d;
  }

  .demo-header a {
    padding-bottom: 2px;
    border-bottom: 1px solid #557065;
    color: #cbd5ce;
  }

  .demo-header a:hover {
    border-color: #62d6bf;
    color: #f4f8f5;
  }

  swift-tui-demo {
    position: relative;
    display: block;
    min-height: 350px;
    overflow: hidden;
    background: #101512;
  }

  swift-tui-demo iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #101512;
  }

  .demo-state {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: start;
    gap: 15px;
    padding: 28px;
    background: #101512;
  }

  .demo-state[hidden],
  .demo-ready[hidden] {
    display: none;
  }

  .demo-state p,
  .demo-state strong {
    max-width: 32ch;
    margin: 0;
  }

  .demo-state p {
    color: #9aa79e;
    font-size: 14px;
  }

  .demo-state button,
  .demo-state a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 15px;
    border: 1px solid #62d6bf;
    border-radius: 3px;
    background: #62d6bf;
    color: #101512;
    font-size: 13px;
    font-weight: 650;
  }

  .demo-state button:hover,
  .demo-state a:hover {
    background: #8be1cf;
  }

  .demo-state--loading {
    align-content: center;
    justify-items: center;
  }

  .loading-mark {
    width: 24px;
    height: 2px;
    background: #62d6bf;
    animation: loading 900ms ease-in-out infinite alternate;
    transform-origin: left center;
  }

  @keyframes loading {
    from {
      opacity: 0.35;
      transform: scaleX(0.25);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  .demo-state--error > div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .demo-state--error a {
    border-color: #4a584f;
    background: transparent;
    color: #e8eee9;
  }

  .demo-ready {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    margin: 0;
    padding: 6px 9px;
    border: 1px solid #314039;
    background: rgb(16 21 18 / 88%);
    color: #b8c4bc;
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .demo-fallback {
    display: grid;
    align-content: center;
    gap: 13px;
    min-height: 350px;
    padding: 30px;
  }

  .demo-fallback p,
  .demo-fallback strong {
    max-width: 44ch;
    margin: 0;
  }

  .demo-fallback p {
    color: #9aa79e;
  }

  .demo-fallback .fallback-label {
    color: #62d6bf;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .demo-fallback code {
    color: #d5ddd7;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .demo-fallback a {
    justify-self: start;
    padding-bottom: 2px;
    border-bottom: 1px solid #62d6bf;
    color: #d5ddd7;
    font-size: 13px;
  }

  .demo-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 18px;
    padding: 10px 15px;
    border-top: 1px solid #2a342d;
    color: #7f8c83;
    font-size: 10px;
  }

  @media (max-width: 600px) {
    swift-tui-demo,
    .demo-fallback {
      min-height: 300px;
    }

    .demo-header {
      align-items: flex-start;
    }

    .demo-footer {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-mark {
      animation: none;
    }
  }
</style>
