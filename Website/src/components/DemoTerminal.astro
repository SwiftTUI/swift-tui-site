---
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const iframeSrc = `${base}/webexample/?embed=marketing`;
const webExampleHref = `${base}/webexample/`;
const sourceHref = "https://github.com/SwiftTUI/swift-tui-counter-demo/tree/main/WebExample";
const isDev = import.meta.env.DEV;
const webExampleDir =
  process.env.WEBEXAMPLE_DIR ?? "../.build/public-inputs/swift-tui-counter-demo/WebExample";
const hasLocalArtifact =
  existsSync(resolve(process.cwd(), webExampleDir, "pages-dist/index.html")) &&
  existsSync(resolve(process.cwd(), webExampleDir, "pages-dist/TerminalApp/dist/assets/app.wasm"));
const showDevFallback = isDev && !hasLocalArtifact;

interface Props {
  id?: string;
}

const { id = "demo-terminal" } = Astro.props;
---

<section class="demo" id={id} aria-label="Live SwiftTUI counter">
  <header class="demo-head">
    <div>
      <strong>Live demo</strong>
      <span>The counter, compiled to WebAssembly</span>
    </div>
    <a href={webExampleHref}>Open separately</a>
  </header>

  {
    showDevFallback ? (
      <div class="demo-fallback" role="status">
        <p class="demo-fallback__label">Local WASI artifact not built</p>
        <strong>The counter is composed during the full site build.</strong>
        <p>
          Run <code>bun run build:wasm:dev</code> in <code>Website/</code>, then reload this page.
        </p>
        <a class="swifttui-btn swifttui-btn--secondary" href={sourceHref} rel="noreferrer noopener">
          Inspect the browser host source
        </a>
      </div>
    ) : (
      <swift-tui-demo data-src={iframeSrc}>
        <iframe
          title="SwiftTUI CounterApp running through the WASI browser host"
          referrerpolicy="same-origin"
          tabindex="0"
        />

        <div class="demo-state demo-state--idle" data-state-view="idle">
          <p>A real SwiftTUI app, running live in your browser.</p>
          <button class="swifttui-btn swifttui-btn--primary" type="button" data-load-demo>
            Load live counter
          </button>
        </div>

        <div
          class="demo-state demo-state--loading"
          data-state-view="loading"
          hidden
          role="status"
          aria-live="polite"
        >
          <span class="loading-mark" aria-hidden="true" />
          <p>Starting the WASI runtime</p>
        </div>

        <div class="demo-state demo-state--error" data-state-view="error" hidden role="alert">
          <strong>The live frame did not start.</strong>
          <p>The source and static site remain available.</p>
          <div class="button-row">
            <button class="swifttui-btn swifttui-btn--primary" type="button" data-retry-demo>
              Retry
            </button>
            <a class="swifttui-btn swifttui-btn--secondary" href={sourceHref} rel="noreferrer noopener">
              View source
            </a>
          </div>
        </div>
      </swift-tui-demo>
    )
  }

  <footer class="demo-foot">
    <span>Real SwiftTUI view</span>
    <span>Static WASI bundle</span>
    <span>Canvas with a semantic accessibility tree</span>
  </footer>
</section>

<script>
  class SwiftTUIDemo extends HTMLElement {
    private frame: HTMLIFrameElement;
    private timeout: number | undefined;
    private observer: IntersectionObserver | undefined;
    private started = false;

    constructor() {
      super();
      const frame = this.querySelector("iframe");
      if (!(frame instanceof HTMLIFrameElement)) {
        throw new Error("SwiftTUI demo iframe is missing");
      }
      this.frame = frame;
    }

    connectedCallback() {
      this.querySelector("[data-load-demo]")?.addEventListener("click", () => this.start());
      this.querySelector("[data-retry-demo]")?.addEventListener("click", () => this.retry());
      window.addEventListener("message", this.onMessage);

      if ("IntersectionObserver" in window) {
        this.observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) this.start();
          },
          { threshold: 0.2 },
        );
        this.observer.observe(this);
      }
    }

    disconnectedCallback() {
      window.removeEventListener("message", this.onMessage);
      this.observer?.disconnect();
      if (this.timeout !== undefined) window.clearTimeout(this.timeout);
    }

    private onMessage = (event: MessageEvent) => {
      if (
        event.origin !== window.location.origin ||
        event.source !== this.frame.contentWindow ||
        event.data?.type !== "swifttui-demo-ready"
      ) {
        return;
      }
      if (this.timeout !== undefined) window.clearTimeout(this.timeout);
      this.setState("ready");
    };

    private start() {
      if (this.started) return;
      this.started = true;
      this.observer?.disconnect();
      this.setState("loading");
      this.frame.src = this.dataset.src ?? "";
      this.timeout = window.setTimeout(() => this.setState("error"), 25_000);
    }

    private retry() {
      if (this.timeout !== undefined) window.clearTimeout(this.timeout);
      this.started = false;
      this.frame.removeAttribute("src");
      this.start();
    }

    private setState(state: "idle" | "loading" | "ready" | "error") {
      this.dataset.state = state;
      this.querySelectorAll<HTMLElement>("[data-state-view]").forEach((view) => {
        view.hidden = view.dataset.stateView !== state;
      });
    }
  }

  if (!customElements.get("swift-tui-demo")) {
    customElements.define("swift-tui-demo", SwiftTUIDemo);
  }
</script>

<style>
  /* The terminal itself is dark in both themes: it is a screen, not a card. */
  .demo {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-height: 100%;
    background: var(--color-offgray-1000);
    color: var(--color-offgray-100);
  }

  .demo-head,
  .demo-foot {
    font-size: 12px;
    line-height: 16px;
  }

  .demo-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--space-12);
    padding: var(--space-2) var(--space-4);
    border-bottom: var(--border-width) solid var(--color-offgray-900);
  }

  .demo-head > div {
    display: grid;
  }

  .demo-head strong {
    color: var(--color-white);
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.5;
  }

  .demo-head span {
    color: var(--color-offgray-400);
  }

  .demo-head a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--divider-accent);
    white-space: nowrap;
  }

  .demo-head a:hover {
    text-decoration-style: double;
    text-decoration-color: currentColor;
  }

  swift-tui-demo {
    position: relative;
    display: block;
    min-height: 350px;
    overflow: hidden;
    background: var(--color-offgray-1000);
  }

  swift-tui-demo iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--color-offgray-1000);
  }

  .demo-state {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: start;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-offgray-1000);
  }

  .demo-state[hidden] {
    display: none;
  }

  .demo-state p,
  .demo-state strong {
    max-width: 32ch;
  }

  .demo-state strong {
    color: var(--color-white);
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 16.8px;
  }

  .demo-state p {
    color: var(--color-offgray-300);
    font-size: 14px;
  }

  .demo-state--loading {
    justify-items: center;
  }

  .loading-mark {
    width: var(--space-6);
    height: 2px;
    background: var(--color-accent);
    animation: loading 1s ease-in-out infinite alternate;
    transform-origin: left center;
  }

  @keyframes loading {
    from {
      opacity: 0.35;
      transform: scaleX(0.25);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  .demo-fallback {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-3);
    min-height: 350px;
    padding: var(--space-6);
  }

  .demo-fallback p,
  .demo-fallback strong {
    max-width: 44ch;
  }

  .demo-fallback strong {
    color: var(--color-white);
    font-family: var(--font-serif);
    font-weight: 400;
  }

  .demo-fallback p {
    color: var(--color-offgray-300);
  }

  .demo-fallback__label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .demo-fallback code {
    background: var(--color-offgray-900);
    color: var(--color-offgray-100);
  }

  .demo-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5) var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-top: var(--border-width) solid var(--color-offgray-900);
    color: var(--color-offgray-400);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media (max-width: 599px) {
    swift-tui-demo,
    .demo-fallback {
      min-height: 300px;
    }

    .demo-foot {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-mark {
      animation: none;
    }
  }
</style>
