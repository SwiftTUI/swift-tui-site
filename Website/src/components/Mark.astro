---
import logo from "../../logo/logo.svg";

// The pixel-art disc, self-coloured: never recoloured, rounded or smoothed.
interface Props {
  size?: number;
  class?: string;
}

const { size = 23, class: className } = Astro.props;
const logoSrc = typeof logo === "string" ? logo : logo.src;
---

<img
  class:list={["mark", className]}
  src={logoSrc}
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  decoding="async"
/>
