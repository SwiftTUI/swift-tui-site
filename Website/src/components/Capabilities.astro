---
import Button from "./Button.astro";
import FeatureCard from "./FeatureCard.astro";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const features = [
  {
    title: "Draw and compose",
    copy: "Arcs, custom paths, shape clips, gradients and layered images. Play a GIF once, a few times, or continuously.",
    detail: "Path · clipShape · AnimatedImage",
    anchor: "drawing",
  },
  {
    title: "Give state motion",
    copy: "Roll changing numbers, morph compatible paths, and move shared elements between layouts. Built-in motion respects reduced-motion preferences.",
    detail: "withAnimation · matchedGeometryEffect",
    anchor: "motion",
  },
  {
    title: "Build a workspace",
    copy: "Compose lazy sections, scroll nested panes, and keep models alive across tab switches. Lists and tables provide selection and tall rows.",
    detail: "LazyVStack · List · Table · TabView",
    anchor: "collections",
  },
  {
    title: "Meet the input device",
    copy: "Focus-scoped commands for a keyboard. Visible controls and scroll panning for touch. Open styles keep a control's behavior attached to its presentation.",
    detail: "onMoveCommand · ButtonStyle · FocusState",
    anchor: "interaction",
  },
];
---

<Section id="capabilities" aria-labelledby="capabilities-title">
  <SectionHead id="capabilities-title" eyebrow="What you can build" align="center">
    <Fragment slot="title">Beyond a screen of text.</Fragment>
    Build an editor, a live dashboard, or a workspace with the same views,
    state and layout model.
  </SectionHead>

  <div class="card-grid card-grid--two capability-grid">
    {
      features.map((feature) => (
        <FeatureCard title={feature.title} href={`${base}/capabilities/#${feature.anchor}`}>
          {feature.copy}
          <span slot="meta" class="capability-sym mono">
            {feature.detail}
          </span>
        </FeatureCard>
      ))
    }
  </div>

  <div class="button-row capability-more">
    <Button href={`${base}/capabilities/`} variant="secondary" trailingIcon="chevronRight">
      Explore the building blocks
    </Button>
  </div>
</Section>

<style>
  .capability-grid {
    max-width: 920px;
    margin: 0 auto;
  }

  .capability-sym {
    display: block;
    margin-top: var(--space-3);
    color: var(--text-accent);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    overflow-wrap: anywhere;
  }

  .capability-more {
    justify-content: center;
    margin-top: var(--space-6);
  }
</style>
