---
// Cells carry an explicit state (yes | partial | no) decoupled from their
// label, so a "—" can still carry a qualifier (e.g. "— immediate-mode").
// Verdicts fact-checked June 2026 against each framework's current release;
// see the legend below for versions.
const rows = [
  {
    name: "SwiftTUI",
    accent: true,
    cells: [
      { s: "yes", t: "✓" },
      { s: "yes", t: "✓ SwiftUI-shaped" },
      { s: "yes", t: "✓ tap·drag·hover" },
      { s: "yes", t: "✓ SwiftUIHost · Android" },
      { s: "yes", t: "✓ WebHost · DOM" },
      { s: "yes", t: "✓ WASI · DOM" },
    ],
  },
  {
    name: "Bubble Tea (Go)",
    cells: [
      { s: "yes", t: "✓" },
      { s: "yes", t: "✓ Elm arch" },
      { s: "partial", t: "~ mouse events" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
    ],
  },
  {
    name: "Textual (Python)",
    cells: [
      { s: "yes", t: "✓" },
      { s: "yes", t: "✓ widgets · CSS" },
      { s: "partial", t: "~ mouse · hover" },
      { s: "no", t: "—" },
      { s: "yes", t: "✓ serve · xterm" },
      { s: "no", t: "—" },
    ],
  },
  {
    name: "Ratatui (Rust)",
    cells: [
      { s: "yes", t: "✓" },
      { s: "no", t: "— immediate-mode" },
      { s: "partial", t: "~ backend only" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
      { s: "partial", t: "~ Ratzilla · DOM" },
    ],
  },
  {
    name: "Ink (JS/React)",
    cells: [
      { s: "yes", t: "✓" },
      { s: "yes", t: "✓ React" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
    ],
  },
];
const headers = [
  "Terminal rendering",
  "Declarative UI",
  "Pointer & gestures",
  "Native app embed",
  "Served to browser",
  "Static WASM build",
];
---
<section class="compare" id="compare">
  <div class="shell">
    <header class="head">
      <span class="eyebrow"><span class="num">/01</span>Where SwiftTUI sits</span>
      <h2>One author surface. Five hosts.</h2>
      <p class="lede">
        One declarative <span class="mono">View</span> tree, rendered to five
        hosts &mdash; a terminal, a native SwiftUI surface, an Android Compose
        surface (early preview), a localhost WebHost, and a static WASM bundle.
        Both browser paths paint to the DOM with a real accessibility tree, not
        a terminal emulator. Here's how that surface area lines up against
        other modern TUI frameworks: the first two columns are common ground,
        the last four are where the same source travels.
      </p>
    </header>

    <div class="grid mono" role="table" aria-label="TUI framework comparison">
      <div class="row head-row" role="row">
        <span class="cell name" role="columnheader">framework</span>
        {headers.map((h) => <span class="cell" role="columnheader">{h}</span>)}
      </div>
      {rows.map((r) => (
        <div class={`row ${r.accent ? "accent" : ""}`} role="row">
          <span class="cell name" role="rowheader">{r.name}</span>
          {r.cells.map((c) => (
            <span class="cell" role="cell" data-state={c.s}>{c.t}</span>
          ))}
        </div>
      ))}
    </div>

    <p class="foot mono">
      Compared June 2026 against current releases &mdash; Bubble Tea 2.0 ·
      Textual 8.2 · Ratatui 0.30 · Ink 7.0. <span class="lk">✓</span>&nbsp;first-party
      · <span class="lk">~</span>&nbsp;partial, third-party, or raw mouse events
      · <span class="lk">—</span>&nbsp;none. Ratzilla is an ecosystem crate;
      Textual's browser host streams a server-side process through xterm.js.
      SwiftTUI's Android embed is an early arm64-v8a preview.
    </p>
  </div>
</section>

<style>
  .compare {
    padding: 64px 0 40px;
    border-top: 1px solid var(--line);
    margin-top: 48px;
  }
  .head { max-width: 760px; margin-bottom: 36px; }
  .head h2 { margin-top: 16px; }
  .head .lede { margin-top: 14px; max-width: 72ch; }

  .grid {
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    overflow: hidden;
    background: var(--panel);
    font-size: 12px;
  }
  .row {
    display: grid;
    grid-template-columns: 1.1fr repeat(6, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .row:last-child { border-bottom: 0; }
  .row.head-row {
    background: var(--panel-2);
    color: var(--ink-3);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .row.accent { background: linear-gradient(180deg, rgba(var(--accent-rgb),0.06), rgba(var(--accent-rgb),0.02)); }
  .row.accent .name { color: var(--accent); font-weight: 500; }
  .cell {
    padding: 12px 14px;
    border-right: 1px solid var(--line);
    color: var(--ink-2);
  }
  .cell:last-child { border-right: 0; }
  .cell.name { color: var(--ink); }
  .cell[data-state="yes"] { color: var(--accent); }
  .cell[data-state="no"]  { color: var(--ink-4); }
  .cell[data-state="partial"] { color: var(--warn); }

  .foot { margin-top: 14px; font-size: 11px; color: var(--ink-4); line-height: 1.7; }
  .foot .lk { color: var(--ink-2); }

  @media (max-width: 1080px) {
    .grid { font-size: 11px; }
    .cell { padding: 10px 8px; }
  }
  @media (max-width: 980px) {
    .grid { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .row { min-width: 900px; }
  }
</style>
