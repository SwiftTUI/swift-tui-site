---
// Pre-paint theme bootstrap + global toggle wiring.
//
// Inlined and blocking (is:inline) so it runs before first paint and the page
// never flashes the wrong appearance. Light is the design system's primary
// theme: an explicit saved choice wins; otherwise the page follows the OS,
// and keeps following it live until the user makes a choice. The toggle
// button (#theme-toggle) lives in SiteHeader; this wires it once it exists.
---
<script is:inline>
  (function () {
    "use strict";
    var STORAGE_KEY = "swifttui-theme";
    var root = document.documentElement;
    var mql = window.matchMedia
      ? window.matchMedia("(prefers-color-scheme: dark)")
      : null;

    function storedTheme() {
      try {
        var value = localStorage.getItem(STORAGE_KEY);
        return value === "light" || value === "dark" ? value : null;
      } catch (error) {
        return null;
      }
    }

    function systemTheme() {
      return mql && mql.matches ? "dark" : "light";
    }

    function apply(theme) {
      root.dataset.theme = theme;
    }

    apply(storedTheme() || systemTheme());

    if (mql) {
      var onSystemChange = function () {
        if (!storedTheme()) apply(systemTheme());
      };
      if (mql.addEventListener) mql.addEventListener("change", onSystemChange);
      else if (mql.addListener) mql.addListener(onSystemChange);
    }

    function wireToggle() {
      var button = document.getElementById("theme-toggle");
      if (!button) return;
      var sync = function () {
        var isDark = root.dataset.theme === "dark";
        var label = isDark ? "Switch to light theme" : "Switch to dark theme";
        button.setAttribute("aria-pressed", String(isDark));
        button.setAttribute("aria-label", label);
        button.setAttribute("title", label);
      };
      button.addEventListener("click", function () {
        var next = root.dataset.theme === "dark" ? "light" : "dark";
        apply(next);
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch (error) {
          /* storage unavailable (private mode); the theme still applies */
        }
        sync();
      });
      sync();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", wireToggle);
    } else {
      wireToggle();
    }
  })();
</script>
