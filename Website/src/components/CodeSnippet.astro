---
import { Code } from "astro:components";
import "../styles/code-snippet.css";

interface Props {
  id: string;
  code: string;
  label: string;
  lang?: "swift" | "bash";
}
const { id, code, label, lang = "swift" } = Astro.props;
---

<div class="code-snippet">
  <div class="snippet-head">
    <span id={`${id}-label`} class="pane-label">{label}</span>
    <button type="button" class="snippet-copy" data-copy-target={id} hidden aria-label={`Copy ${label}`}>
      <span data-copy-label>Copy</span>
    </button>
    <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
  </div>
  <div id={id} class="snippet-code" role="region" aria-labelledby={`${id}-label`} tabindex="0">
    <Code code={code} lang={lang} theme="css-variables" />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach((button) => {
    button.hidden = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener("click", async () => {
      const container = document.getElementById(button.dataset.copyTarget ?? "");
      const code = container?.querySelector("code");
      const label = button.querySelector("[data-copy-label]");
      const status = button.parentElement?.querySelector("[data-copy-status]");
      if (!code || !label || !status) return;
      if (timer !== undefined) clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        label.textContent = "Copied";
        status.textContent = "Copied to clipboard.";
      } catch {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(code);
        selection?.removeAllRanges();
        selection?.addRange(range);
        container?.focus();
        label.textContent = "Select & copy";
        status.textContent = "Clipboard unavailable. The code is selected; use your device’s copy command.";
      }
      timer = setTimeout(() => {
        label.textContent = "Copy";
        status.textContent = "";
      }, 4000);
    });
  });
</script>
