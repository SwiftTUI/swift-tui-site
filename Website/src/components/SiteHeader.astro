---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = `${base}/`;
const repo = "https://github.com/SwiftTUI/swift-tui";

// The primary row keeps demo, product, examples, docs, and source close.
// The SwiftUI migration guide remains in the reading paths and footer.
const links = [
  { href: `${home}#demo`, label: "Demo" },
  { href: `${home}#why`, label: "Why SwiftTUI" },
  { href: `${base}/capabilities/`, label: "Features" },
  { href: `${base}/showcase/`, label: "Showcase" },
  { href: `${base}/guides/`, label: "Docs" },
];
---

{
  /* Marks the document as script-capable before the header is parsed, so the
     collapsed-panel styles only apply when the disclosure button can open it.
     Without JS the nav degrades to a plain stacked list. */
}
<script is:inline>
  document.documentElement.dataset.navEnhanced = "true";
</script>

<header class="site-header section" data-nav-open="false">
  <div class="swifttui-nav">
    <div class="swifttui-nav__side site-lead">
      <a class="swifttui-nav__logo" href={home} aria-label="SwiftTUI home">
        <Mark size={23} />
        <span class="swifttui-nav__wordmark">SwiftTUI</span>
      </a>
      <nav class="site-nav" id="site-nav" aria-label="Primary">
        <ul>
          {
            links.map((link) => (
              <li>
                <Button href={link.href} size="sm" variant="ghost">
                  {link.label}
                </Button>
              </li>
            ))
          }
          <li >
            <Button href={repo} size="sm" variant="ghost" external>
              GitHub
            </Button>
          </li>
        </ul>
      </nav>
    </div>

    <div class="swifttui-nav__side site-actions">
      <button
        class="swifttui-btn swifttui-btn--ghost swifttui-btn--sm theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        title="Switch to dark theme"
      >
        <Icon name="sun" />
        <Icon name="moon" />
      </button>
      <button
        class="swifttui-btn swifttui-btn--secondary swifttui-btn--sm nav-toggle"
        id="nav-toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Open menu"
        title="Open menu"
      >
        <Icon name="menu" />
        <Icon name="x" />
      </button>
    </div>
  </div>
  <i class="node node--l" aria-hidden="true"></i>
  <i class="node node--r" aria-hidden="true"></i>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--nav-background);
    border-top: var(--border-width) solid var(--border-default);
  }

  /* The header owns the rules; the nav block draws none of its own. */
  .site-header .swifttui-nav {
    border: 0;
    background: transparent;
  }

  .site-lead {
    min-width: 0;
    gap: var(--space-4);
  }

  .site-nav ul {
    gap: var(--space-0-5);
  }

  .site-nav__panel-only {
    display: none;
  }

  .site-actions {
    gap: var(--space-1-5);
    flex: none;
  }

  .theme-toggle,
  .site-github {
    width: var(--control-height);
    height: var(--control-height);
    padding: 0;
    justify-content: center;
  }

  .theme-toggle :global(svg) {
    color: var(--icon);
  }

  .nav-toggle {
    display: none;
    width: var(--control-height);
    height: var(--control-height);
    padding: 0;
    justify-content: center;
  }

  .nav-toggle :global(.icon-x),
  .nav-toggle[aria-expanded="true"] :global(.icon-menu) {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] :global(.icon-x) {
    display: block;
  }

  /* ── collapsed nav ────────────────────────────────────────────────
     Below the width where the row still fits, the nav becomes a
     disclosure panel under the header: every destination, plus GitHub,
     as full-width rows. Gated on [data-nav-enhanced] so that without JS
     the list simply stays visible below the wordmark. */
  @media (max-width: 1023px) {
    .site-header .swifttui-nav {
      flex-wrap: wrap;
      height: auto;
      min-height: var(--header-height);
      padding-block: var(--space-2-5);
    }

    .site-lead {
      flex-wrap: wrap;
    }

    .site-nav {
      flex-basis: 100%;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav li :global(.swifttui-btn) {
      width: 100%;
      justify-content: flex-start;
      min-height: 44px;
    }

    .site-nav__panel-only {
      display: block;
      margin-top: var(--space-2);
      padding-top: var(--space-2);
      border-top: var(--border-width) solid var(--border-default);
    }

    :root[data-nav-enhanced="true"] .nav-toggle {
      display: inline-flex;
    }

    :root[data-nav-enhanced="true"] .site-github {
      display: none;
    }

    :root[data-nav-enhanced="true"] .site-header .swifttui-nav {
      height: var(--header-height);
      padding-block: 0;
      flex-wrap: nowrap;
    }

    :root[data-nav-enhanced="true"] .site-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      z-index: 41;
      max-height: calc(100dvh - var(--header-height) - var(--space-4));
      padding: var(--space-2) var(--space-3) var(--space-4);
      overflow-y: auto;
      overscroll-behavior: contain;
      border-bottom: var(--border-width) solid var(--border-default);
      background: var(--nav-background);
      box-shadow: var(--shadow-demo-pill);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      pointer-events: none;
      transition:
        opacity 150ms cubic-bezier(0.4, 0, 0.2, 1),
        transform 150ms cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0s linear 150ms;
    }

    :root[data-nav-enhanced="true"] .site-header[data-nav-open="true"] .site-nav {
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
      transition:
        opacity 150ms cubic-bezier(0.4, 0, 0.2, 1),
        transform 150ms cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0s;
    }
  }


  @media (prefers-reduced-motion: reduce) {
    :root[data-nav-enhanced="true"] .site-nav,
    :root[data-nav-enhanced="true"] .site-header[data-nav-open="true"] .site-nav {
      transition: none;
    }
  }
</style>

<script>
  // Disclosure wiring for the collapsed nav. Open/closed styling is CSS-only
  // (keyed off [data-nav-open]); this owns the state, the ARIA that mirrors
  // it, and the dismissals a menu is expected to honour.
  (function () {
    "use strict";
    const header = document.querySelector<HTMLElement>(".site-header");
    const toggle = document.getElementById("nav-toggle");
    const nav = document.getElementById("site-nav");
    if (!header || !toggle || !nav) return;

    const isOpen = () => header.dataset.navOpen === "true";
    const isCollapsed = () => getComputedStyle(toggle).display !== "none";

    const setOpen = (open: boolean) => {
      header.dataset.navOpen = open ? "true" : "false";
      toggle.setAttribute("aria-expanded", String(open));
      const label = open ? "Close menu" : "Open menu";
      toggle.setAttribute("aria-label", label);
      toggle.setAttribute("title", label);
    };

    toggle.addEventListener("click", () => setOpen(!isOpen()));
    nav.addEventListener("click", (event) => {
      if ((event.target as Element | null)?.closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return;
      setOpen(false);
      toggle.focus();
    });
    document.addEventListener("click", (event) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    });
    window.addEventListener("resize", () => {
      if (isOpen() && !isCollapsed()) setOpen(false);
    });
  })();
</script>
