---
import Button from "./Button.astro";
import FeatureCard from "./FeatureCard.astro";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Four flagship terminal apps, the same 2×2 the swift-tui README carries:
// two interaction-heavy (gifeditor, terminal-workspace), two data-heavy
// (csvui, mrkdwn). The full roster lives on /showcase/. Each caption
// describes what its screenshot actually shows.
const items = [
  {
    slug: "gifeditor",
    title: "GIF Editor",
    body: "Canvas, layers, a scrubbable timeline, pointer tools, undo, export.",
    alt: "SwiftTUI GIF Editor with canvas, layers, tools, and a timeline",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/gifeditor",
  },
  {
    slug: "csvui",
    title: "csvui",
    body: "A 34,000-row table browsed and edited in place.",
    alt: "csvui displaying a large tab-separated table of world cities",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/csvui",
  },
  {
    slug: "terminal-workspace",
    title: "Terminal Workspace",
    body: "Tabs, splits, and a command palette over embedded terminals.",
    alt: "Terminal Workspace showing tabs and split panes of live shells",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/terminal-workspace",
  },
  {
    slug: "mrkdwn",
    title: "mrkdwn",
    body: "A responsive Markdown reader, shown reading the SwiftTUI README.",
    alt: "mrkdwn rendering the SwiftTUI README as a navigable document",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/mrkdwn",
  },
];
---

<Section id="proof" aria-labelledby="proof-title">
  <SectionHead id="proof-title" eyebrow="Showcase" align="center">
    <Fragment slot="title">Built with SwiftTUI.</Fragment>
    The counter above fits on one screen. These do not. All four are maintained
    examples in <code>swift-tui-examples</code>: clone the repo and each one
    builds and runs with one command.
  </SectionHead>

  <div class="card-grid card-grid--two proof-grid">
    {
      items.map((item) => (
        <FeatureCard
          title={item.title}
          href={item.repo}
          external
          cta="View source"
          media={{ src: `${base}/showcase/${item.slug}.png`, alt: item.alt, width: 1600, height: 1000 }}
        >
          {item.body}
        </FeatureCard>
      ))
    }
  </div>

  <div class="button-row proof-more">
    <Button href={`${base}/showcase/`} variant="secondary" trailingIcon="chevronRight">
      Browse every example
    </Button>
  </div>
</Section>

<style>
  .proof-grid {
    max-width: 920px;
    margin: 0 auto;
  }

  .proof-more {
    justify-content: center;
    margin-top: var(--space-6);
  }
</style>
