---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// The homepage keeps only two flagship examples — one interaction-heavy
// (gifeditor), one data-heavy (csvui). The full roster lives on /showcase/,
// linked below. Each caption describes what its screenshot actually shows —
// this pane's whole job is credibility, so an image that undersells or
// overshoots its caption costs more than the tile is worth.
type ProofItem = {
  slug: string;
  title: string;
  body: string;
  alt: string;
  repo: string;
};

const items: ProofItem[] = [
  {
    slug: "gifeditor",
    title: "GIF Editor",
    body:
      "A canvas, layers, a scrubbable timeline, pointer tools, undo, and animated GIF export.",
    alt: "SwiftTUI GIF Editor with canvas, layers, tools, and a timeline",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/gifeditor",
  },
  {
    slug: "csvui",
    title: "csvui",
    body:
      "A 34,000-row GeoNames city table, browsed and edited safely in place.",
    alt: "csvui displaying a large tab-separated table of world cities",
    repo: "https://github.com/SwiftTUI/swift-tui-examples/tree/main/csvui",
  },
];
---

<section class="proof" id="proof" aria-labelledby="proof-title">
  <div class="shell">
    <header class="proof-head">
      <p class="home-kicker">Built with SwiftTUI</p>
      <h2 id="proof-title">Showcase</h2>
      <p>
        The counter above fits on one screen. These do not. Both are maintained
        examples in <code>swift-tui-examples</code> — clone the repo and every
        example builds and runs with one command.
      </p>
    </header>

    <div class="proof-gallery">
      {
        items.map((item) => (
          <figure class="proof-item">
            <a href={item.repo} rel="noreferrer noopener">
              <img
                src={`${base}/showcase/${item.slug}.png`}
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
                alt={item.alt}
              />
            </a>
            <figcaption>
              <strong>{item.title}</strong>
              <span>{item.body}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <a class="proof-link" href={`${base}/showcase/`}>
      Browse every example and host
    </a>
  </div>
</section>

<style>
  .proof {
    padding: clamp(57.333px, 7.333vw, 100px) 0 clamp(86px, 11vw, 150px);
  }

  .proof-head {
    display: grid;
    gap: 17px;
    max-width: 780px;
    margin-bottom: 46px;
  }

  .proof-head h2 {
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 520;
    line-height: 0.96;
    letter-spacing: -0.058em;
    text-wrap: balance;
  }

  .proof-head > p:last-child {
    max-width: 57ch;
    color: var(--home-muted);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .proof-head code {
    color: var(--home-accent-ink);
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  .proof-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--home-ink);
    border-left: 1px solid var(--home-ink);
  }

  .proof-item {
    min-width: 0;
    margin: 0;
    border-right: 1px solid var(--home-ink);
    border-bottom: 1px solid var(--home-ink);
  }

  .proof-item a {
    display: block;
    overflow: hidden;
    background: #101512;
  }

  .proof-item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .proof-item a:hover img {
    transform: scale(1.008);
  }

  .proof-item figcaption {
    display: grid;
    gap: 7px;
    min-height: 78px;
    padding: 17px 19px;
  }

  .proof-item figcaption strong {
    font-size: 15px;
    letter-spacing: -0.015em;
  }

  .proof-item figcaption span {
    max-width: 62ch;
    color: var(--home-muted);
    font-size: 13px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .proof-link {
    display: inline-block;
    margin-top: 26px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--home-accent);
    color: var(--home-accent-ink);
    font-size: 14px;
  }

  .proof-link:hover {
    border-color: var(--home-ink);
    color: var(--home-ink);
  }

  @media (max-width: 720px) {
    .proof-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-item img,
    .proof-item a:hover img {
      transform: none;
      transition: none;
    }
  }
</style>
