---
import Mark from "./Mark.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-main">
      <div class="footer-brand">
        <a href={`${base}/`} aria-label="SwiftTUI home">
          <Mark size={16} />
          <span>SwiftTUI</span>
        </a>
        <p>SwiftUI semantics, drawn in terminal cells.</p>
      </div>

      <nav class="footer-links" aria-label="Footer navigation">
        <div>
          <h2>Build</h2>
          <a href={`${base}/#demo`}>Live demo</a>
          <a href={`${base}/#get-started`}>Get started</a>
          <a href={`${base}/docs/documentation/`}>DocC reference</a>
          <a href={`${base}/showcase/`}>Examples</a>
        </div>
        <div>
          <h2>Understand</h2>
          <a href={`${base}/pipeline/`}>Rendering pipeline</a>
          <a href={`${base}/docs/documentation/swifttui/choosing-modules-and-platforms`}>
            Hosts and platforms
          </a>
        </div>
        <div>
          <h2>Project</h2>
          <a
            href="https://github.com/SwiftTUI/swift-tui"
            rel="noreferrer noopener"
          >
            GitHub
          </a>
          <a
            href="https://discord.gg/8j35kYDFxn"
            rel="noreferrer noopener"
          >
            Discord
          </a>
          <a
            href="https://github.com/SwiftTUI/swift-tui/releases"
            rel="noreferrer noopener"
          >
            Releases
          </a>
          <a
            href="https://github.com/SwiftTUI/swift-tui/issues"
            rel="noreferrer noopener"
          >
            Issues
          </a>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      {
        /* The separating space lives in an expression: the build's HTML
           compression collapses plain whitespace between text and elements,
           which is how "© 2026OPTIONAL.DEV" shipped. */
      }
      <span>
        © {year}{" "}
        <a href="https://optional.dev" rel="noreferrer noopener">OPTIONAL.DEV</a>
      </span>
      <a
        href="https://github.com/SwiftTUI/swift-tui/blob/0.7.1/LICENSE"
        rel="noreferrer noopener"
      >
        MIT License
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 72px 0 28px;
    border-top: 1px solid var(--line-strong);
    background: var(--bg);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(50px, 9vw, 130px);
  }

  .footer-brand {
    display: grid;
    align-content: start;
    gap: 16px;
  }

  .footer-brand > a {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 11px;
    color: var(--ink);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .footer-brand p {
    max-width: 30ch;
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1.55;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
  }

  .footer-links > div {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .footer-links h2 {
    margin: 0 0 6px;
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-links a {
    color: var(--ink-2);
    font-size: 12.5px;
    line-height: 1.45;
    transition: color 140ms ease;
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 54px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: 10.5px;
  }

  .footer-bottom a:hover {
    color: var(--ink-2);
  }

  @media (max-width: 760px) {
    .footer-main {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .footer-links {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-links a {
      transition: none;
    }
  }
</style>
