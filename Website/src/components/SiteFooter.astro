---
import pkg from "../../package.json";
import Mark from "./Mark.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const year = new Date().getFullYear();
const version = pkg.version;

type FooterLink = { href: string; label: string; external?: boolean };
const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: "Build",
    links: [
      { href: `${base}/#demo`, label: "Live demo" },
      { href: `${base}/#get-started`, label: "Get started" },
      { href: `${base}/guides/`, label: "Documentation" },
      { href: `${base}/docs/documentation/`, label: "API reference" },
      { href: `${base}/docs/charts/documentation/swifttuicharts`, label: "Charts reference" },
      {
        href: `${base}/docs/terminal-view/documentation/swifttuiterminalview`,
        label: "Terminal view reference",
      },
      { href: `${base}/showcase/`, label: "Examples" },
    ],
  },
  {
    title: "Understand",
    links: [
      { href: `${base}/capabilities/`, label: "What you can build" },
      { href: `${base}/compare/`, label: "Compare frameworks" },
      { href: `${base}/differences-from-swiftui/`, label: "Differences from SwiftUI" },
      { href: `${base}/pipeline/`, label: "Under the hood" },
      {
        href: `${base}/docs/documentation/swifttuiruntime/hosts-and-platforms`,
        label: "Beyond the terminal",
      },
    ],
  },
  {
    title: "Project",
    links: [
      { href: `${base}/updates/`, label: "Updates" },
      { href: `${base}/updates/rss.xml`, label: "RSS feed" },
      { href: "https://github.com/SwiftTUI/swift-tui", label: "GitHub", external: true },
      { href: "https://discord.gg/8j35kYDFxn", label: "Discord", external: true },
      { href: "https://github.com/SwiftTUI/swift-tui/releases", label: "Releases", external: true },
      { href: "https://github.com/SwiftTUI/swift-tui/issues", label: "Issues", external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="footer-logo" href={`${base}/`} aria-label="SwiftTUI home">
        <Mark size={23} />
        <span class="swifttui-nav__wordmark">SwiftTUI</span>
      </a>
      <p>SwiftUI semantics, drawn in terminal cells.</p>
      <p class="footer-version mono">
        {version} ·{" "}
        <a
          href={`https://github.com/SwiftTUI/swift-tui/blob/${version}/CHANGELOG.md`}
          rel="noreferrer noopener"
        >
          changelog
        </a>
      </p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      {
        columns.map((column) => (
          <div>
            <h2 class="h6">{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href} rel={link.external ? "noreferrer noopener" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="footer-bottom">
    {
      /* The separating space lives in an expression: HTML compression
         collapses plain whitespace between text and elements. */
    }
    <span>
      © {year}{" "}
      <a href="https://optional.dev" rel="noreferrer noopener">OPTIONAL.DEV</a>
    </span>
    <a
      href={`https://github.com/SwiftTUI/swift-tui/blob/${version}/LICENSE`}
      rel="noreferrer noopener"
    >
      MIT License
    </a>
  </div>
</footer>

<style>
  /* The footer is the site's one dark surface in both themes. */
  .site-footer {
    padding: var(--space-12) var(--section-x) var(--space-6);
    border-top: var(--border-width) solid var(--border-default);
    background: var(--color-offgray-1000);
    color: var(--color-offgray-300);
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.025em;
  }

  .site-footer a {
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-footer a:hover {
    color: var(--color-white);
  }

  .site-footer :focus-visible {
    outline-color: var(--focus-ring-contrast);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(200px, 0.8fr) minmax(0, 1.4fr);
    gap: var(--space-12);
  }

  .footer-brand {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
  }

  .footer-logo .swifttui-nav__wordmark {
    color: var(--color-white);
  }

  .footer-brand p {
    max-width: 30ch;
    color: var(--color-offgray-300);
  }

  .footer-version {
    font-size: 12px;
    letter-spacing: 0;
    color: var(--color-offgray-400);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .footer-links h2 {
    margin-bottom: var(--space-3);
    color: var(--color-white);
  }

  .footer-links ul {
    display: grid;
    gap: var(--space-1-5);
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    color: var(--color-offgray-300);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-offgray-900);
    color: var(--color-offgray-400);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  @media (max-width: 767px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 479px) {
    .footer-links {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
