---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="home-quickstart" id="quickstart" aria-labelledby="quickstart-title">
  <div class="shell">
    <header class="quickstart-head">
      <p class="home-kicker">Quickstart</p>
      <h2 id="quickstart-title">SwiftPM &plus; <code>swift run</code>.</h2>
      <p>
        Get started. Make a SwiftPM package, author an{" "}
        <code>App</code>, and run it in the terminal.
      </p>
    </header>

    <div class="quickstart-command" aria-label="Run command">
      <span aria-hidden="true">$</span>
      <code>swift package init --type executable --name Counter</code>
      <button type="button" data-copy-text="swift run">Copy command</button>
    </div>

    <div class="quickstart-files">
      <article class="quickstart-file">
        <header>
          <span>Package.swift</span>
          <button type="button" data-copy-target="quickstart-package">
            Copy
          </button>
        </header>
        <pre
          id="quickstart-package"
          tabindex="0"
        ><code><span class="cm">// swift-tools-version: 6.3</span>
<span class="kw">import</span> <span class="ty">PackageDescription</span>

<span class="kw">let</span> package = <span class="ty">Package</span>(
  name: <span class="str">"Counter"</span>,
  platforms: [<span class="str">.macOS(.v15)</span>], // remove line on linux
  dependencies: [
    .package(
      url: <span class="str">"https://github.com/SwiftTUI/swift-tui"</span>,
      .upToNextMinor(from: <span class="str">"0.3.3"</span>)
    ),
  ],
  targets: [
    .executableTarget(
      name: <span class="str">"Counter"</span>,
      dependencies: [
        .product(
          name: <span class="str">"SwiftTUI"</span>,
          package: <span class="str">"swift-tui"</span>
        ),
      ]
    ),
  ]
)</code></pre>
      </article>

      <article class="quickstart-file">
        <header>
          <span>Sources/Counter/Counter.swift</span>
          <button type="button" data-copy-target="quickstart-app">Copy</button>
        </header>
        <pre
          id="quickstart-app"
          tabindex="0"
        ><code><span class="kw">import</span> <span class="ty">SwiftTUI</span>

<span class="at">@main</span>
<span class="kw">struct</span> <span class="ty">CounterApp</span>: <span class="ty">App</span> &#123;
  <span class="kw">var</span> body: <span class="kw">some</span> <span class="ty">Scene</span> &#123;
    <span class="ty">WindowGroup</span>(<span class="str">"Counter"</span>) &#123;
      <span class="ty">CounterView</span>()
    &#125;
  &#125;
&#125;

<span class="kw">struct</span> <span class="ty">CounterView</span>: <span class="ty">View</span> &#123;
  <span class="at">@State</span> <span class="kw">private var</span> count = <span class="num">0</span>

  <span class="kw">var</span> body: <span class="kw">some</span> <span class="ty">View</span> &#123;
    <span class="ty">VStack</span>(spacing: <span class="num">1</span>) &#123;
      <span class="ty">TextFigure</span>(<span class="str">"\(count)"</span>, font: .future)
        .frame(minWidth: <span class="num">14</span>, alignment: .center)
      <span class="ty">Button</span>(<span class="str">"Increment"</span>) &#123; count += <span class="num">1</span> &#125;
    &#125;
    .padding(<span class="num">2</span>)
  &#125;
&#125;</code></pre>
      </article>
    </div>
    <div class="quickstart-command" aria-label="Run command">
      <span aria-hidden="true">$</span>
      <code>swift run</code>
      <button type="button" data-copy-text="swift run">Copy command</button>
    </div>
    <div class="quickstart-foot">
      <p>
        Requires Swift 6.3.
      </p>
      <a href={`${base}/docs/documentation/`}>Continue in the DocC reference</a>
    </div>
    <p class="copy-status" data-copy-status aria-live="polite"></p>
  </div>

</section>

<script>
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");

  async function copyText(text: string) {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const helper = document.createElement("textarea");
    helper.value = text;
    helper.readOnly = true;
    helper.style.position = "fixed";
    helper.style.opacity = "0";
    document.body.append(helper);
    helper.select();
    const copied = document.execCommand("copy");
    helper.remove();
    if (!copied) throw new Error("Copy command was not accepted");
  }

  document.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach(
    (button) => {
      button.addEventListener("click", async () => {
        const target = document.getElementById(button.dataset.copyTarget ?? "");
        if (!target) return;
        try {
          await copyText(target.textContent ?? "");
          button.textContent = "Copied";
          if (copyStatus) copyStatus.textContent = "File copied to the clipboard.";
        } catch {
          button.textContent = "Select manually";
          if (copyStatus) copyStatus.textContent = "Copy is unavailable in this browser.";
        }
        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1800);
      });
    },
  );

  document.querySelectorAll<HTMLButtonElement>("[data-copy-text]").forEach(
    (button) => {
      const original = button.textContent;
      button.addEventListener("click", async () => {
        try {
          await copyText(button.dataset.copyText ?? "");
          button.textContent = "Copied";
          if (copyStatus) copyStatus.textContent = "Command copied to the clipboard.";
        } catch {
          button.textContent = "Select manually";
          if (copyStatus) copyStatus.textContent = "Copy is unavailable in this browser.";
        }
        window.setTimeout(() => {
          button.textContent = original;
        }, 1800);
      });
    },
  );
</script>

<style>
  .home-quickstart {
    padding: clamp(57.333px, 7.333vw, 100px) 0
      clamp(86px, 11vw, 150px);
    border-top: 1px solid var(--home-ink);
    border-bottom: 1px solid var(--home-ink);
  }

  .quickstart-head {
    display: grid;
    gap: 17px;
    max-width: 780px;
    margin-bottom: 46px;
  }

  .quickstart-head h2 {
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 520;
    line-height: 0.96;
    letter-spacing: -0.058em;
  }

  .quickstart-head h2 code {
    color: var(--home-accent-ink);
    font-family: var(--font-mono);
    font-size: 0.78em;
  }

  .quickstart-head > p:last-child {
    max-width: 57ch;
    color: var(--home-muted);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .quickstart-head code {
    font-family: var(--font-mono);
  }

  .quickstart-command {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    min-height: 62px;
    padding: 0 16px;
    border: 1px solid var(--home-ink);
    background: var(--home-ink);
    color: var(--home-paper);
    font-family: var(--font-mono);
  }

  .quickstart-command > span {
    color: var(--home-terminal-accent);
  }

  .quickstart-command button {
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid #536158;
    border-radius: 3px;
    color: #dbe3dd;
    font-size: 11px;
  }

  .quickstart-command button:hover {
    border-color: var(--home-terminal-accent);
    color: #fff;
  }

  .quickstart-files {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    border: 1px solid var(--home-ink);
  }

  .quickstart-file {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-width: 0;
  }

  .quickstart-file + .quickstart-file {
    border-left: 1px solid var(--home-ink);
  }

  .quickstart-file > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    padding: 8px 13px;
    border-bottom: 1px solid var(--home-line);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .quickstart-file > header span {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--home-muted);
  }

  .quickstart-file > header button {
    flex: 0 0 auto;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--home-line-strong);
    border-radius: 3px;
    color: var(--home-muted);
    font-size: 11px;
  }

  .quickstart-file > header button:hover {
    border-color: var(--home-accent);
    color: var(--home-ink);
  }

  .quickstart-file pre {
    margin: 0;
    padding: 24px 18px 28px;
    overflow: auto;
    background: var(--home-paper);
    color: var(--home-code);
    font-family: var(--font-mono);
    font-size: clamp(10.5px, 0.9vw, 12px);
    line-height: 1.7;
    tab-size: 2;
  }

  .quickstart-file .kw,
  .quickstart-file .at {
    color: var(--home-accent-ink);
    font-weight: 650;
  }

  .quickstart-file .ty {
    color: var(--home-code-type);
  }

  .quickstart-file .str {
    color: var(--home-code-string);
  }

  .quickstart-file .num {
    color: var(--home-code-number);
  }

  .quickstart-file .cm {
    color: var(--home-quiet);
  }

  .quickstart-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 32px;
    margin-top: 18px;
    color: var(--home-muted);
    font-size: 13px;
  }

  .quickstart-foot p {
    max-width: 66ch;
    color: inherit;
  }

  .quickstart-foot a {
    flex: 0 0 auto;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--home-accent);
    color: var(--home-accent-ink);
  }

  .copy-status {
    min-height: 1.5em;
    margin-top: 8px;
    color: var(--home-accent-ink);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  @media (max-width: 920px) {
    .quickstart-files {
      grid-template-columns: 1fr;
    }

    .quickstart-file + .quickstart-file {
      border-top: 1px solid var(--home-ink);
      border-left: 0;
    }

    .quickstart-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
  }

  @media (max-width: 560px) {
    .quickstart-command {
      grid-template-columns: auto 1fr;
      padding-block: 10px;
    }

    .quickstart-command button {
      grid-column: 1 / -1;
      width: 100%;
    }

    .quickstart-file pre {
      max-height: 520px;
      padding-inline: 13px;
      font-size: 10px;
    }
  }
</style>
