---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Four reading paths, ordered by tier: the first-hour docs, the SwiftUI
// primer, the example roster, then the internals walkthrough ("under the
// hood" is a credibility asset for evaluators, not lead copy). Below the
// paths, the home page's ONE host block — browser deployment first, native
// hosts in a clause. Host caveats live on the host repos, not here.
const paths = [
  {
    kicker: "Documentation",
    title: "The first-hour guides: views, state and focus, running apps",
    cta: "Browse the docs",
    href: `${base}/guides/`,
  },
  {
    kicker: "From SwiftUI",
    title: "What transfers, what is deliberately different, and why",
    cta: "Read the primer",
    href: `${base}/differences-from-swiftui/`,
  },
  {
    kicker: "Examples",
    title: "Every maintained terminal app, and the demo on every host",
    cta: "Browse examples",
    href: `${base}/showcase/`,
  },
  {
    kicker: "Under the hood",
    title: "resolve → measure → place → semantics → draw → raster → commit",
    cta: "Read about the pipeline",
    href: `${base}/pipeline/`,
  },
];
---

<section class="next" id="next" aria-labelledby="next-title">
  <div class="shell">
    <header class="next-head">
      <h2 id="next-title">Further reading</h2>
    </header>
    <nav class="audience-paths" aria-label="Choose a SwiftTUI guide">
      {
        paths.map((p) => (
          <a href={p.href}>
            <span>{p.kicker}</span>
            <strong>{p.title}</strong>
            <i>{p.cta}</i>
          </a>
        ))
      }
    </nav>

    <div class="beyond" id="beyond">
      <p class="home-kicker">Beyond the terminal</p>
      <p>
        Terminal first, not terminal only. The same <span class="mono">App</span>{" "}
        runs in a browser: <span class="mono">--web</span> serves it on
        localhost, or build it with <span class="mono">SwiftTUIWASI</span> and
        ship a static bundle with{" "}
        <a href="https://github.com/SwiftTUI/swift-tui-web" rel="noreferrer noopener">
          @swifttui/web</a>, as the demo above is. It also embeds in native apps
        through{" "}
        <a href="https://github.com/SwiftTUI/swift-tui-swiftui" rel="noreferrer noopener">
          swift-tui-swiftui</a>{" "}
        (macOS, iOS) and{" "}
        <a href="https://github.com/SwiftTUI/swift-tui-android" rel="noreferrer noopener">
          swift-tui-android</a>{" "}
        (arm64 preview). No terminal emulators. Start from{" "}
        <a href={`${base}/docs/documentation/swifttuiruntime/hosts-and-platforms`}>
          Hosts and Platforms</a>.
      </p>
    </div>

    <div class="closing">
      <div class="closing-copy">
        <p class="home-kicker">Community</p>
        <h2>Build with us.</h2>
        <p>
          Development happens in public on GitHub, and the people building
          SwiftTUI are on Discord. Come ask questions, show what you are
          building, or talk through a contribution.
        </p>
      </div>
      <div class="closing-action">
        <a
          class="home-button home-button--primary"
          href="https://discord.gg/8j35kYDFxn"
          rel="noreferrer noopener"
        >
          Join the Discord
        </a>
        <a
          class="home-button"
          href="https://github.com/SwiftTUI/swift-tui"
          rel="noreferrer noopener"
        >
          SwiftTUI on GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .next {
    padding: clamp(58.667px, 7.333vw, 100px) 0
      clamp(88px, 11vw, 150px);
    border-bottom: 1px solid var(--home-ink);
  }

  .next-head {
    display: grid;
    gap: 20px;
    max-width: 860px;
    margin-bottom: 52px;
  }

  .next-head h2 {
    font-size: clamp(44px, 6.5vw, 82px);
    font-weight: 520;
    line-height: 0.95;
    letter-spacing: -0.062em;
    text-wrap: balance;
  }

  .audience-paths {
    border-top: 1px solid var(--home-ink);
  }

  .audience-paths a {
    display: grid;
    grid-template-columns: minmax(150px, 0.55fr) minmax(0, 1.35fr) auto;
    gap: 30px;
    align-items: center;
    min-height: 104px;
    border-bottom: 1px solid var(--home-line-strong);
    transition: padding 160ms ease, color 160ms ease;
  }

  .audience-paths a:hover {
    padding-left: 10px;
    color: var(--home-accent-ink);
  }

  .audience-paths span {
    color: var(--home-muted);
  }

  .audience-paths strong {
    font-size: 19px;
    letter-spacing: -0.025em;
  }

  .audience-paths i {
    padding-bottom: 2px;
    border-bottom: 1px solid var(--home-accent);
    font-size: 13px;
    font-style: normal;
  }

  .beyond {
    display: grid;
    gap: 12px;
    max-width: 78ch;
    margin-top: 44px;
  }

  .beyond > p:last-child {
    color: var(--home-muted);
    font-size: 14.5px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .beyond .mono {
    color: var(--home-ink);
    font-size: 0.92em;
  }

  .beyond a {
    padding-bottom: 1px;
    border-bottom: 1px solid var(--home-line-strong);
    color: var(--home-ink);
    white-space: nowrap;
  }

  .beyond a:hover {
    border-color: var(--home-accent);
  }

  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: end;
    margin-top: clamp(72px, 9vw, 118px);
  }

  .closing-copy {
    display: grid;
    gap: 17px;
  }

  .closing-copy h2 {
    max-width: 13ch;
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 520;
    line-height: 0.96;
    letter-spacing: -0.058em;
    text-wrap: balance;
  }

  .closing-copy > p:last-child {
    max-width: 54ch;
    color: var(--home-muted);
    font-size: 16px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .closing-action {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    padding-bottom: 6px;
  }

  @media (max-width: 900px) {
    .audience-paths a {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 22px 0;
    }

    .audience-paths i {
      justify-self: start;
      margin-top: 8px;
    }

    .closing {
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: start;
    }
  }

  @media (max-width: 620px) {
    .closing-action {
      display: grid;
    }

    .closing-action .home-button {
      width: 100%;
    }
  }
</style>
