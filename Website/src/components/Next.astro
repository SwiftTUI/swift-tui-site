---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hosts" id="next" aria-labelledby="next-title">
  <div class="shell">
    <header class="hosts-head">
      <h2 id="next-title">Further reading</h2>
    </header>
    <nav class="audience-paths" aria-label="Choose a SwiftTUI guide">
      <a href={`${base}/docs/documentation/`}>
        <span>Swift Docs</span>
        <strong>Views, state, focus, layout, and controls</strong>
        <i>Open DocC</i>
      </a>
      <a href={`${base}/showcase/`}>
        <span>Examples</span>
        <strong>Maintained applications across the host family</strong>
        <i>Browse examples</i>
      </a>
      <a
        href={`${base}/pipeline/`}
      >
        <span>Concepts</span>
        <strong>resolve → measure → place → semantics → draw → raster → commit</strong>
        <i>Read about the pipeline</i>
      </a>
      <a
        href="https://github.com/SwiftTUI/swift-tui/blob/main/docs/HOSTS-AND-PLATFORMS.md"
        rel="noreferrer noopener"
      >
        <span>Capabilities &amp; platforms</span>
        <strong>Rich cell-based UI on terminal, Web, Native iOS and macOS, Android.</strong>
        <i>Open the host guide</i>
      </a>
    </nav>

    <div class="closing">
      <div class="closing-copy">
        <p class="home-kicker">Pre-release</p>
        <h2>Build the first frame.</h2>
        <p>
          SwiftTUI 0.4.7 is pre-release and pre-1.0. Source-breaking changes are
          expected, and support for external consumers begins at 0.9.0. Bug
          reports and contributions are warmly welcomed.
        </p>
      </div>
      <div class="closing-actions">
        <a
          class="home-button home-button--primary"
          href="https://github.com/SwiftTUI/swift-tui-examples/tree/main/three-hosts-demo"
          rel="noreferrer noopener"
        >
          Clone the counter
        </a>
        <a class="home-button" href={`${base}/docs/documentation/`}>
          Read the API reference
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hosts {
    padding: clamp(58.667px, 7.333vw, 100px) 0
      clamp(88px, 11vw, 150px);
    border-bottom: 1px solid var(--home-ink);
  }

  .hosts-head {
    display: grid;
    gap: 20px;
    max-width: 860px;
    margin-bottom: 52px;
  }

  .hosts-head h2 {
    font-size: clamp(44px, 6.5vw, 82px);
    font-weight: 520;
    line-height: 0.95;
    letter-spacing: -0.062em;
    text-wrap: balance;
  }

  .hosts-head p {
    max-width: 58ch;
    color: var(--home-muted);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .host-map {
    display: grid;
    grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.22fr);
    border-top: 1px solid var(--home-ink);
    border-bottom: 1px solid var(--home-ink);
  }

  .engine {
    display: flex;
    min-height: 320px;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    border-right: 1px solid var(--home-ink);
    background: var(--home-accent);
    color: var(--home-accent-on);
  }

  .engine span {
    font-weight: 700;
  }

  .engine strong {
    max-width: 14ch;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.03;
    letter-spacing: -0.045em;
  }

  .host-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .host-list span {
    display: flex;
    min-height: 104px;
    align-items: flex-end;
    padding: 20px;
    border-right: 1px solid var(--home-line);
    border-bottom: 1px solid var(--home-line);
    color: var(--home-muted);
  }

  .host-list span:nth-child(2n) {
    border-right: 0;
  }

  .host-list span:last-child {
    grid-column: 1 / -1;
    border-bottom: 0;
  }

  .host-caveat {
    max-width: 86ch;
    margin: 15px 0 60px;
    color: var(--home-quiet);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
  }

  .audience-paths {
    border-top: 1px solid var(--home-ink);
  }

  .audience-paths a {
    display: grid;
    grid-template-columns: minmax(150px, 0.55fr) minmax(0, 1.35fr) auto;
    gap: 30px;
    align-items: center;
    min-height: 104px;
    border-bottom: 1px solid var(--home-line-strong);
    transition: padding 160ms ease, color 160ms ease;
  }

  .audience-paths a:hover {
    padding-left: 10px;
    color: var(--home-accent-ink);
  }

  .audience-paths span {
    color: var(--home-muted);
  }

  .audience-paths strong {
    font-size: 19px;
    letter-spacing: -0.025em;
  }

  .audience-paths i {
    padding-bottom: 2px;
    border-bottom: 1px solid var(--home-accent);
    font-size: 13px;
    font-style: normal;
  }

  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: end;
    margin-top: clamp(72px, 9vw, 118px);
  }

  .closing-copy {
    display: grid;
    gap: 17px;
  }

  .closing-copy h2 {
    max-width: 13ch;
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 520;
    line-height: 0.96;
    letter-spacing: -0.058em;
    text-wrap: balance;
  }

  .closing-copy > p:last-child {
    max-width: 54ch;
    color: var(--home-muted);
    font-size: 16px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    padding-bottom: 6px;
  }

  @media (max-width: 900px) {
    .closing {
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: start;
    }
  }

  @media (max-width: 620px) {
    .closing-actions {
      display: grid;
    }

    .closing-actions .home-button {
      width: 100%;
    }
  }

  @media (max-width: 900px) {
    .host-map {
      grid-template-columns: 1fr;
    }

    .engine {
      min-height: 230px;
      border-right: 0;
      border-bottom: 1px solid var(--home-ink);
    }

    .audience-paths a {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 22px 0;
    }

    .audience-paths i {
      justify-self: start;
      margin-top: 8px;
    }
  }

  @media (max-width: 620px) {
    .host-list {
      grid-template-columns: 1fr;
    }

    .host-list span,
    .host-list span:nth-child(2n) {
      border-right: 0;
    }

    .host-list span:last-child {
      grid-column: auto;
    }
  }
</style>
