---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Audience: people choosing a TUI framework, in any language. The pitch is
// the track record and shape of the declarative model itself — never "you
// already know SwiftUI".
const cards = [
  {
    n: "01",
    title: "State in, screen out",
    body:
      "There is no draw loop, no buffer diffing, and no repaint bookkeeping. Views are a pure function of your app's state: change a value and the runtime recomputes layout and rewrites exactly the cells that changed. SwiftUI has spent seven years hardening that model in production; here it is the entire programming model.",
    sym: "View · @State · @Observable · body",
  },
  {
    n: "02",
    title: "Real components, real focus",
    body:
      "Buttons, text fields, pickers, sliders, scroll views, and charts, with a focus engine, tab traversal, keyboard chords, tap · drag · hover gestures, and animation built in. You compose behavior instead of hand-routing key events to widgets.",
    sym: "@FocusState · TapGesture · withAnimation · SwiftTUICharts",
  },
  {
    n: "03",
    title: "The terminal, negotiated for you",
    body:
      "Truecolor, Kitty and Sixel images, OSC 8 hyperlinks, and mouse reporting are probed per session and degrade gracefully: one binary is correct in kitty, a bare SSH session, or CI. You write views, never escape codes.",
    sym: "TerminalCapabilityProfile · Kitty · Sixel · OSC 8",
  },
  {
    n: "04",
    title: "One compiled binary",
    body:
      "Swift 6 compiles your interface into a single fast executable with checked concurrency. Layout and state are type-checked at build time, and tests render frames as integer-cell rasters without a TTY.",
    sym: "SwiftPM · Swift 6 · RasterSurface",
  },
];

// Cells carry an explicit state (yes | partial | no) decoupled from their
// label, so a "—" can still carry a qualifier (e.g. "— immediate-mode").
// Verdicts fact-checked August 2026 against each framework's current release
// (see the legend below for versions). When re-stamping, re-check the
// releases — and Ratzilla's home, which moved from orhun/ to the ratatui org.
const headers = [
  "Terminal rendering",
  "Declarative UI",
  "Pointer & gestures",
  "Native app embed",
  "Served to browser",
  "Static WASM build",
];
const rows = [
  {
    name: "SwiftTUI",
    accent: true,
    cells: [
      { s: "yes", t: "✓" },
      { s: "yes", t: "✓ SwiftUI-shaped" },
      { s: "yes", t: "✓ tap·drag·hover" },
      { s: "yes", t: "✓ SwiftUIHost · Android arm64 preview" },
      { s: "yes", t: "✓ WebHost · DOM" },
      { s: "yes", t: "✓ WASI · DOM" },
    ],
  },
  {
    name: "Bubble Tea (Go)",
    cells: [
      { s: "yes", t: "✓" },
      { s: "yes", t: "✓ Elm arch" },
      { s: "partial", t: "~ mouse events" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
    ],
  },
  {
    name: "Textual (Python)",
    cells: [
      { s: "yes", t: "✓" },
      { s: "yes", t: "✓ widgets · CSS" },
      { s: "partial", t: "~ mouse · hover" },
      { s: "no", t: "—" },
      { s: "yes", t: "✓ serve · xterm" },
      { s: "no", t: "—" },
    ],
  },
  {
    name: "Ratatui (Rust)",
    cells: [
      { s: "yes", t: "✓" },
      { s: "no", t: "— immediate-mode" },
      { s: "partial", t: "~ backend only" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
      { s: "partial", t: "~ Ratzilla · DOM" },
    ],
  },
  {
    name: "Ink (JS/React)",
    cells: [
      { s: "yes", t: "✓" },
      { s: "yes", t: "✓ React" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
      { s: "no", t: "—" },
    ],
  },
];
---

<section class="why" id="why" aria-labelledby="why-title">
  <div class="shell">
    <header class="why-head">
      <p class="home-kicker">Why SwiftTUI</p>
      <h2 id="why-title">A proven UI model, pointed at the terminal.</h2>
      <p>
        Most TUI toolkits make you choose between a low-level draw loop and a
        widget set with its own ad-hoc state story. SwiftTUI instead borrows
        the declarative model SwiftUI has proven at platform scale (the
        interface is a function of state) and aims it at terminal cells. You
        declare views; the framework owns layout, focus, redraw, and the
        terminal itself.
      </p>
    </header>

    <ol class="why-cards" aria-label="What that model buys you">
      {
        cards.map((card) => (
          <li>
            <div class="card-head">
              <span class="ix mono">{card.n}</span>
              <h3>{card.title}</h3>
            </div>
            <p>{card.body}</p>
            <span class="sym mono">{card.sym}</span>
          </li>
        ))
      }
    </ol>

    <div class="compare-head">
      <h3>How it compares</h3>
      <p>
        Capability axes against the other major TUI frameworks. The first
        three are the day-one terminal experience; the last three are where
        the same source can travel later.
      </p>
    </div>

    <div class="compare-scroll">
      <div class="compare mono" role="table" aria-label="TUI framework comparison">
        <div class="row head-row" role="row">
          <span class="cell name" role="columnheader">framework</span>
          {headers.map((h) => <span class="cell" role="columnheader">{h}</span>)}
        </div>
        {
          rows.map((r) => (
            <div class={`row ${r.accent ? "accent" : ""}`} role="row">
              <span class="cell name" role="rowheader">{r.name}</span>
              {r.cells.map((c) => (
                <span class="cell" role="cell" data-state={c.s}>{c.t}</span>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <p class="compare-foot mono">
      Verified August 2026 against current releases: Bubble Tea 2.0 ·
      Textual 8.2 · Ratatui 0.30 · Ink 7.1. <span class="lk">✓</span>&nbsp;first-party
      · <span class="lk">~</span>&nbsp;partial, separate package, or raw mouse events
      · <span class="lk">—</span>&nbsp;none. Ratzilla is a separate crate in the
      Ratatui org; Textual's browser host streams a server-side process through
      xterm.js. SwiftTUI's browser paths render to the DOM with a real
      accessibility tree for one-way semantic presentation; assistive-origin
      control actions are not part of the 0.9 preview.
    </p>

    <p class="why-hosts">
      Terminal first: when you need it, the same views also run in the
      browser, in native macOS and iOS windows, and in an Android arm64
      preview. Android packaging is limited to <span class="mono">arm64-v8a</span>,
      API 28+, and NDK 27.3.13750724 through the AAR/Gradle-plugin path. Full IME
      marked/pre-edit composition is incomplete and semantics are one-way; a
      connected journey exists, but current candidate device acceptance remains
      pending.
      Start with the{" "}
      <a href={`${base}/docs/documentation/swifttui/choosing-modules-and-platforms`}>
        hosts &amp; platforms guide</a>, or go straight to{" "}
      <a href="https://github.com/SwiftTUI/swift-tui-web" rel="noreferrer noopener">
        swift-tui-web</a>,{" "}
      <a href="https://github.com/SwiftTUI/swift-tui-swiftui" rel="noreferrer noopener">
        swift-tui-swiftui</a>, or{" "}
      <a href="https://github.com/SwiftTUI/swift-tui-android" rel="noreferrer noopener">
        swift-tui-android</a>.
    </p>
  </div>
</section>

<style>
  .why {
    padding: clamp(57.333px, 7.333vw, 100px) 0 clamp(64px, 8vw, 110px);
    border-top: 1px solid var(--home-ink);
  }

  .why-head {
    display: grid;
    gap: 17px;
    max-width: 820px;
    margin-bottom: 46px;
  }

  .why-head h2 {
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 520;
    line-height: 0.96;
    letter-spacing: -0.058em;
    text-wrap: balance;
  }

  .why-head > p:last-child {
    max-width: 62ch;
    color: var(--home-muted);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .why-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 0 56px;
    padding: 0;
    border-top: 1px solid var(--home-ink);
    border-left: 1px solid var(--home-ink);
    list-style: none;
  }

  .why-cards li {
    display: flex;
    min-width: 0;
    min-height: 210px;
    flex-direction: column;
    padding: 20px 21px 18px;
    border-right: 1px solid var(--home-ink);
    border-bottom: 1px solid var(--home-ink);
    background: var(--home-paper);
  }

  .card-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .ix {
    flex: 0 0 auto;
    color: var(--home-quiet);
    font-size: 10.5px;
    letter-spacing: 0.06em;
  }

  .why-cards h3 {
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .why-cards li > p {
    margin-top: 11px;
    max-width: 62ch;
    color: var(--home-muted);
    font-size: 13.5px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .sym {
    margin-top: auto;
    padding-top: 16px;
    color: var(--home-quiet);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    word-break: break-word;
  }

  .compare-head {
    display: grid;
    gap: 10px;
    max-width: 780px;
    margin-bottom: 22px;
  }

  .compare-head h3 {
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .compare-head p {
    max-width: 60ch;
    color: var(--home-muted);
    font-size: 14.5px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .compare-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--home-ink);
    background: var(--home-paper);
  }

  .compare {
    min-width: 920px;
    font-size: 12px;
  }

  .row {
    display: grid;
    grid-template-columns: 1.2fr repeat(6, minmax(0, 1fr));
    border-bottom: 1px solid var(--home-line);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row.head-row {
    border-bottom: 1px solid var(--home-line-strong);
    color: var(--home-quiet);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .row.accent {
    background: var(--home-paper-soft);
  }

  .row.accent .name {
    color: var(--home-accent-ink);
    font-weight: 650;
  }

  .cell {
    padding: 12px 14px;
    border-right: 1px solid var(--home-line);
    color: var(--home-muted);
  }

  .cell:last-child {
    border-right: 0;
  }

  .cell.name {
    color: var(--home-ink);
  }

  .cell[data-state="yes"] {
    color: var(--home-accent-ink);
  }

  .cell[data-state="partial"] {
    color: var(--home-code-string);
  }

  .cell[data-state="no"] {
    color: var(--home-quiet);
  }

  .compare-foot {
    margin-top: 14px;
    max-width: 100ch;
    color: var(--home-quiet);
    font-size: 11px;
    line-height: 1.7;
  }

  .compare-foot .lk {
    color: var(--home-ink);
  }

  .why-hosts {
    margin-top: 34px;
    max-width: 74ch;
    color: var(--home-muted);
    font-size: 14.5px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .why-hosts a {
    padding-bottom: 1px;
    border-bottom: 1px solid var(--home-line-strong);
    color: var(--home-ink);
    white-space: nowrap;
  }

  .why-hosts a:hover {
    border-color: var(--home-accent);
  }

  @media (max-width: 880px) {
    .why-cards {
      grid-template-columns: 1fr;
    }

    .why-cards li {
      min-height: 0;
    }
  }
</style>
