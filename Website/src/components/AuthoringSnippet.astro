---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Actual SwiftTUI render of CounterView (with `.border(set: .innerHalfBlock).padding()`),
// captured as previewUnicode HTML. Injected via `set:html` so Astro's default
// HTML compression does not collapse the significant box-drawing whitespace
// that the `white-space: pre` surface depends on. The static frame is real; the
// click-to-increment interaction below is a lightweight JS simulation (see the
// pane footer disclosure), not the live WASM runtime.
const renderMarkup = `<div style="font-family: monospace; white-space: pre;background-color: #2d2a2e;color: #fcfcfa;-webkit-user-select: none;user-select: none;">
 <div style="display: inline;color: rgb(252, 252, 250);">&#9623;&#9604;&#9604;&#9604;&#9604;&#9604;&#9604;&#9604;&#9604;&#9604;&#9604;&#9604;&#9604;&#9604;&#9604;&#9604;&#9622;</div>
 <div style="display: inline;color: rgb(252, 252, 250);">&#9616;</div>               <div style="display: inline;color: rgb(252, 252, 250);">&#9612;</div>
 <div style="display: inline;color: rgb(252, 252, 250);">&#9616;</div>               <div style="display: inline;color: rgb(252, 252, 250);">&#9612;</div>
 <div style="display: inline;color: rgb(252, 252, 250);">&#9616;</div>   <div id="authoring-demo-count" style="display: inline;color: rgb(252, 252, 250);font-weight: bold;">Count: 0</div>    <div style="display: inline;color: rgb(252, 252, 250);">&#9612;</div>
 <div style="display: inline;color: rgb(252, 252, 250);">&#9616;</div>               <div style="display: inline;color: rgb(252, 252, 250);">&#9612;</div>
 <div style="display: inline;color: rgb(252, 252, 250);">&#9616;</div>  <div class="increment-btn" style="display: inline;background-color: rgb(78, 60, 57);cursor: pointer;"> </div><div class="increment-btn" style="display: inline;color: rgb(255, 255, 255);background-color: rgb(78, 60, 57);cursor: pointer;">Increment</div><div class="increment-btn" style="display: inline;background-color: rgb(78, 60, 57);cursor: pointer;"> </div>  <div style="display: inline;color: rgb(252, 252, 250);">&#9612;</div>
 <div style="display: inline;color: rgb(252, 252, 250);">&#9616;</div>               <div style="display: inline;color: rgb(252, 252, 250);">&#9612;</div>
 <div style="display: inline;color: rgb(252, 252, 250);">&#9616;</div>               <div style="display: inline;color: rgb(252, 252, 250);">&#9612;</div>
 <div style="display: inline;color: rgb(252, 252, 250);">&#9629;&#9600;&#9600;&#9600;&#9600;&#9600;&#9600;&#9600;&#9600;&#9600;&#9600;&#9600;&#9600;&#9600;&#9600;&#9600;&#9624;</div></div>`;
---
<section class="snippet" id="authoring">
  <div class="shell">
    <header class="head">
      <span class="eyebrow"><span class="num">/05</span>Authoring &rarr; render</span>
      <h2>Read this and you can write SwiftTUI.</h2>
      <p class="lede">
        Every line is SwiftUI you already know.
        <span class="mono">@main App</span>, <span class="mono">WindowGroup</span>,
        <span class="mono">@State</span>, <span class="mono">@FocusState</span>,
        <span class="mono">.onAppear</span> &mdash; no new mental model. SwiftTUI
        lowers this exact tree through its render pipeline into the integer-cell
        output on the right.
      </p>
    </header>

    <div class="grid">
      <article class="pane source">
        <div class="pane-bar mono">
          <span class="path">CounterApp.swift</span>
          <span class="meta">innerHalfBlock · padded</span>
        </div>
        <pre class="code mono"><code><span class="kw">import</span> <span class="ty">SwiftTUI</span>

<span class="at">@main</span> <span class="kw">struct</span> <span class="ty">CounterApp</span>: <span class="ty">App</span> &#123;
  <span class="kw">var</span> body: <span class="kw">some</span> <span class="ty">Scene</span> &#123;
    <span class="ty">WindowGroup</span>(<span class="s">"Counter"</span>) &#123;
      <span class="ty">CounterView</span>()
    &#125;
  &#125;
&#125;

<span class="kw">struct</span> <span class="ty">CounterView</span>: <span class="ty">View</span> &#123;
  <span class="at">@State</span> <span class="kw">private var</span> count = <span class="n">0</span>
  <span class="at">@FocusState</span> <span class="kw">private var</span> focused: <span class="ty">Bool</span>

  <span class="kw">var</span> body: <span class="kw">some</span> <span class="ty">View</span> &#123;
    <span class="ty">VStack</span>(spacing: <span class="n">1</span>) &#123;
      <span class="ty">Text</span>(<span class="s">"Count: \(count)"</span>).bold()
      <span class="ty">Button</span>(<span class="s">"Increment"</span>) &#123; count += <span class="n">1</span> &#125;
        .focused(<span class="s">$</span>focused)
    &#125;
    .onAppear &#123; focused = <span class="kw">true</span> &#125;
    .padding(<span class="n">2</span>)
    .border(set: .innerHalfBlock)
    .padding()
  &#125;
&#125;</code></pre>
      </article>

      <article class="pane output">
        <div class="pane-bar mono">
          <span class="dotline">
            <span class="d red"></span><span class="d yellow"></span><span class="d green"></span>
          </span>
          <span class="path">TerminalSurfaceRenderer · previewUnicode</span>
          <span class="meta">simulated input</span>
        </div>
        <div class="render-surface" id="authoring-demo" set:html={renderMarkup}></div>
        <div class="pane-foot mono">
          <span><span class="caret">›</span> Real frame from <em>.border(set: .innerHalfBlock)</em></span>
          <span class="sim-note">Counter interaction simulated in JS &mdash; <a href={`${base}/webexample/`}>run the live WASM build &rarr;</a></span>
        </div>
      </article>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.getElementById("authoring-demo");
    if (!root) return;
    var count = 0;
    var countEl = document.getElementById("authoring-demo-count");
    var buttons = root.querySelectorAll(".increment-btn");

    function increment() {
      count += 1;
      countEl.textContent = "Count: " + count;
    }

    for (var i = 0; i < buttons.length; i++) {
      buttons[i].addEventListener("click", increment);
    }
  })();
</script>

<style>
  .snippet {
    padding: 96px 0 56px;
    border-top: 1px solid var(--line);
    margin-top: 64px;
  }
  .head { max-width: 760px; margin-bottom: 48px; }
  .head h2 { margin-top: 16px; }
  .head .lede { margin-top: 18px; max-width: 70ch; }

  .grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 18px;
    align-items: stretch;
  }
  .pane {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    overflow: hidden;
    background: var(--panel);
  }
  .pane-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 11px;
    color: var(--ink-3);
    background: var(--panel-2);
  }
  .pane-bar .path { color: var(--ink-2); }
  .pane-bar .meta { margin-left: auto; color: var(--ink-4); }
  .dotline { display: inline-flex; gap: 6px; }
  .dotline .d {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--term-dot);
  }
  .dotline .d.red { background: var(--term-red); }
  .dotline .d.yellow { background: var(--term-yellow); }
  .dotline .d.green { background: var(--term-green); }

  .code {
    margin: 0;
    padding: 18px 18px 22px;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--ink);
    overflow-x: auto;
    flex: 1;
  }
  .code .kw { color: var(--tok-kw); }
  .code .ty { color: var(--tok-type); }
  .code .s  { color: var(--tok-str); }
  .code .n  { color: var(--tok-num); }
  .code .at { color: var(--tok-num); }

  .output { background: var(--inset); }
  .render-surface {
    flex: 1;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    overflow: auto;
    background:
      linear-gradient(180deg, rgba(var(--accent-rgb),0.05) 0%, transparent 18%, transparent 100%);
  }
  /* Injected via set:html, so these children lack the scoped data attribute. */
  :global(.render-surface > div) {
    font-size: 13px;
    line-height: 1.45;
    border-radius: 8px;
    padding: 12px 16px;
  }
  :global(.increment-btn) { transition: filter 0.12s ease; }
  :global(.increment-btn:hover) { filter: brightness(1.3); }

  .pane-foot {
    display: flex;
    gap: 18px;
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    color: var(--ink-3);
    background: transparent;
  }
  .pane-foot .caret { color: var(--accent); margin-right: 6px; }
  .pane-foot em { font-style: normal; color: var(--ink-2); }
  .pane-foot .sim-note { margin-left: auto; color: var(--ink-4); }
  .pane-foot .sim-note a { color: var(--accent); text-decoration: none; }
  .pane-foot .sim-note a:hover { text-decoration: underline; }

  @media (max-width: 1080px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
