---
import Button from "./Button.astro";
import CodeSnippet from "./CodeSnippet.astro";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const commands = `git clone https://github.com/SwiftTUI/swift-tui-counter-demo.git
cd swift-tui-counter-demo
swift run --package-path counter counter`;
---

<Section id="get-started" class="get-started" aria-labelledby="start-title">
  <div class="quick-start-grid">
    <div>
      <SectionHead id="start-title" eyebrow="03 / Get started">
        <Fragment slot="title">Your terminal. Your first app.</Fragment>
        Run the same counter locally with Swift 6.4 on macOS, Linux, or Windows.
      </SectionHead>
      <a class="link" href={`${base}/guides/#toolchain`}>Need a Swift toolchain? <span aria-hidden="true">→</span></a>
    </div>
    <div>
      <CodeSnippet id="run-counter" label="Run the counter" lang="bash" code={commands} />
      <p class="quick-start-note"><kbd class="swifttui-kbd">Space</kbd> or a click increments.
        <kbd class="swifttui-kbd">Ctrl-C</kbd> restores your shell.</p>
    </div>
  </div>
  <div class="section-tail">
    <span>Ready to make it your own?</span>
    <Button href={`${base}/guides/#first-hour`} variant="secondary" trailingIcon="chevronRight">Build your first app</Button>
  </div>
</Section>
