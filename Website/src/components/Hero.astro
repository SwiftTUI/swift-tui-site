---
import Button from "./Button.astro";
import CodeSnippet from "./CodeSnippet.astro";
import DemoTerminal from "./DemoTerminal.astro";
import Section from "./Section.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const excerpt = String.raw`@State private var count = 0

var body: some View {
  VStack(spacing: 1) {
    TextFigure("\(count)", font: .future)
    Button("Increment") { count += 1 }
  }
}`;
const source = String.raw`import SwiftTUI

struct CounterView: View {
  @State private var count = 0

  var body: some View {
    VStack(spacing: 1) {
      TextFigure("\(count)", font: .future)
        .frame(minWidth: 14, alignment: .center)
      Button("Increment") { count += 1 }
    }
    .frame(maxWidth: .infinity, maxHeight: .infinity)
  }
}

@main
struct CounterApp: App {
  var body: some Scene {
    WindowGroup("Counter") { CounterView() }
  }
}`;
---

<Section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero__copy">
    <h1 id="hero-title" class="h0 hero__title">SwiftUI semantics, drawn in terminal cells.</h1>
    <p class="lead">
      Build terminal apps with views, state, focus, and animation.
      Compile a native executable for macOS, Linux, or Windows.
    </p>
    <div class="button-row hero__actions">
      <Button href={`${base}/#get-started`} variant="primary" icon="terminal">Get started</Button>
      <Button href={`${base}/#proof`} variant="secondary" trailingIcon="chevronRight">Explore examples</Button>
    </div>
  </div>

  <div class="code-to-frame media-frame" id="demo">
    <div class="render-pane"><DemoTerminal id="demo-terminal" /></div>
    <div class="source-pane">
      <CodeSnippet id="counter-excerpt" label="CounterView · excerpt" code={excerpt} />
      <p class="source-note">Change the state. SwiftTUI updates the view.</p>
    </div>
  </div>
  <details class="source-disclosure terminal-disclosure">
    <summary>View and copy the complete Swift app</summary>
    <p class="disclosure-note">This minimal example leaves out the live counter’s ripple animation.
      <a class="link" href="https://github.com/SwiftTUI/swift-tui-counter-demo/blob/main/counter/Sources/CounterCore/CounterView.swift" rel="noreferrer noopener">Explore the demo source</a>.
    </p>
    <CodeSnippet id="counter-app" label="CounterApp.swift" code={source} />
  </details>
</Section>
