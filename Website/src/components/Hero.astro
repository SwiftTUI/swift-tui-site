---
import DemoTerminal from "./DemoTerminal.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sourceHref =
  "https://github.com/SwiftTUI/swift-tui-examples/blob/main/counter/Sources/CounterCore/CounterApp.swift";
---

<section class="home-hero" aria-labelledby="hero-title">
  <div class="shell">
    <div class="hero-intro">
      <h1 id="hero-title">Build Swift Terminal User Interfaces</h1>
      <div class="hero-deck">
        <p>
          Views, State, Observation, Gestures, Animations—
        </p>
        <p>
          SwiftUI semantics, drawn in terminal cells.
        </p>
        <div class="hero-actions">
          <a class="home-button home-button--primary" href="#quickstart">
            Start with SwiftPM
          </a>
          <a
            class="home-button"
            href="https://github.com/SwiftTUI/swift-tui"
            rel="noreferrer noopener"
          >
            View source
          </a>
        </div>
        <a class="hero-docs-link" href={`${base}/docs/documentation/`}>
          Read the API reference
        </a>
      </div>
    </div>

    <div class="code-to-frame">
      <article class="source-pane" aria-labelledby="counter-source-title">
        <header>
          <div>
            <strong id="counter-source-title">Source</strong>
            <span>CounterApp.swift</span>
          </div>
          <a href={sourceHref} rel="noreferrer noopener">Open file</a>
        </header>
        <pre
          class="counter-source"
          tabindex="0"
        ><code><span class="kw">public import</span> <span class="ty">SwiftTUIRuntime</span>

<span class="kw">struct</span> <span class="ty">CounterView</span>: <span class="ty">View</span> &#123;

  <span class="at">@Environment</span>(\.terminalSize) <span class="kw">private var</span> terminalSize
  <span class="at">@State</span> <span class="kw">private var</span> count = <span class="num">0</span>
  <span class="at">@State</span> <span class="kw">private var</span> activeRipple: <span class="ty">Bool</span> = <span class="kw">false</span>

  <span class="kw">var</span> body: <span class="kw">some</span> <span class="ty">View</span> &#123;
    <span class="ty">VStack</span>(spacing: <span class="num">1</span>) &#123;
      <span class="ty">TextFigure</span>(<span class="str">"\(count)"</span>, font: .future)
        .frame(minWidth: <span class="num">14</span>, alignment: .center)
      <span class="ty">Button</span>(<span class="str">"Increment"</span>) &#123;
        count += <span class="num">1</span>
      &#125;
    &#125;
    .frame(maxWidth: .<span class="ty">infinity</span>, maxHeight: .<span class="ty">infinity</span>)
    .onChange(of: count) &#123;
      <span class="kw">if</span> !activeRipple &#123;
        activeRipple = <span class="kw">true</span>
      &#125;
    &#125;
    .background &#123;
      <span class="kw">if</span> activeRipple &#123;
        <span class="ty">RippleLayer</span>(reach: reach) &#123;
          activeRipple = <span class="kw">false</span>
        &#125;
      &#125;
    &#125;
  &#125;

  <span class="kw">private var</span> reach: <span class="ty">Double</span> &#123;
    <span class="kw">let</span> horizontal = <span class="ty">Double</span>(terminalSize.width) / <span class="num">2</span>
    <span class="kw">let</span> vertical = <span class="ty">Double</span>(terminalSize.height)
    <span class="kw">return</span> (horizontal * horizontal + vertical * vertical).squareRoot()
  &#125;
&#125;
</code></pre>
      </article>

      <div class="render-pane">
        <DemoTerminal id="demo" />
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    padding: clamp(33.333px, 5.333vw, 70.667px) 0 70px;
  }

  .hero-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.34fr) minmax(300px, 0.66fr);
    gap: clamp(44px, 8vw, 124px);
    align-items: end;
    padding-bottom: clamp(54px, 8vw, 92px);
  }

  h1 {
    max-width: 15ch;
    font-size: clamp(58px, 7.8vw, 108px);
    font-weight: 520;
    line-height: 0.91;
    letter-spacing: -0.072em;
    text-wrap: balance;
  }

  .hero-deck {
    display: grid;
    gap: 24px;
    padding-bottom: 6px;
  }

  .hero-deck > p {
    max-width: 39ch;
    color: var(--home-muted);
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .hero-docs-link {
    justify-self: start;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--home-line-strong);
    color: var(--home-muted);
    font-size: 13px;
  }

  .hero-docs-link:hover {
    border-color: var(--home-accent);
    color: var(--home-ink);
  }

  .code-to-frame {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    min-height: 520px;
    border: 1px solid var(--home-ink);
    background: var(--home-paper);
  }

  .source-pane,
  .render-pane {
    min-width: 0;
  }

  .source-pane {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    border-right: 1px solid var(--home-line-strong);
  }

  .source-pane > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 60px;
    padding: 10px 15px;
    border-bottom: 1px solid var(--home-line);
    font-family: var(--font-mono);
  }

  .source-pane > header > div {
    display: grid;
    gap: 2px;
  }

  .source-pane > header strong,
  .source-pane > header span,
  .source-pane > header a {
    font-size: 11px;
  }

  .source-pane > header strong {
    font-weight: 600;
  }

  .source-pane > header span {
    color: var(--home-muted);
  }

  .source-pane > header a {
    padding-bottom: 2px;
    border-bottom: 1px solid var(--home-line-strong);
    color: var(--home-muted);
  }

  .source-pane > header a:hover {
    border-color: var(--home-accent);
    color: var(--home-ink);
  }

  .counter-source {
    margin: 0;
    padding: 24px 20px 28px;
    overflow: auto;
    background: var(--home-paper);
    color: var(--home-code);
    font-family: var(--font-mono);
    font-size: clamp(10.5px, 0.9vw, 12px);
    line-height: 1.68;
    tab-size: 2;
  }

  .counter-source .kw,
  .counter-source .at {
    color: var(--home-accent-ink);
    font-weight: 650;
  }

  .counter-source .ty {
    color: var(--home-code-type);
  }

  .counter-source .str {
    color: var(--home-code-string);
  }

  .counter-source .num {
    color: var(--home-code-number);
  }

  .counter-source .cm {
    color: var(--home-quiet);
  }

  .render-pane {
    min-height: 520px;
  }

  @media (max-width: 980px) {
    .hero-intro {
      grid-template-columns: 1fr;
      gap: 30px;
      align-items: start;
    }

    h1 {
      max-width: 13ch;
    }

    .hero-deck {
      max-width: 600px;
    }

    .code-to-frame {
      grid-template-columns: 1fr;
    }

    .source-pane {
      order: 2;
      border-top: 1px solid var(--home-line-strong);
      border-right: 0;
    }

    .render-pane {
      order: 1;
      min-height: 420px;
    }
  }

  @media (max-width: 620px) {
    .home-hero {
      padding-top: 29.333px;
    }

    h1 {
      max-width: 100%;
      font-size: clamp(48px, 14vw, 68px);
      overflow-wrap: normal;
    }

    .hero-actions {
      display: grid;
    }

    .home-button {
      width: 100%;
    }

    .code-to-frame {
      min-height: 0;
    }

    .render-pane {
      min-height: 360px;
    }

    .counter-source {
      max-height: 470px;
      padding-inline: 14px;
      font-size: 10px;
    }
  }
</style>
